---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Start a Project | ATECT Architecture" description="Tell ATECT Architecture about your residential or commercial project in Maryland, Washington, DC, or Virginia.">
<section class="page-hero"><div class="eyebrow">Start a Project</div><h1>Tell us what you’re planning.</h1><p>Share the basics of your project and we can identify the right next conversation.</p></section>
<section class="section">
  <div class="contact-grid">
    <div>
      <div class="eyebrow">Project Inquiry</div>
      <h2>Start with the essentials.</h2>
      <p class="section-intro">Tell us about the property, project goals and where you are in the process. The project address helps us understand the location and service area before we follow up.</p>
      <p><strong>Service Area</strong><br />Maryland • Washington, DC • Virginia</p>
      <p class="form-note">Project location is required so we can determine service area and better understand your project.</p>
    </div>

    <form class="contact-form" action="mailto:info@atectarchitecture.com" method="post" enctype="text/plain">
      <div class="form-section-title">Contact Information</div>
      <label for="name">Name *</label>
      <input id="name" name="Name" autocomplete="name" required />

      <label for="email">Email *</label>
      <input id="email" type="email" name="Email" autocomplete="email" required />

      <label for="phone">Phone *</label>
      <input id="phone" name="Phone" type="tel" autocomplete="tel" required />

      <label for="contact-method">Preferred Contact Method</label>
      <select id="contact-method" name="Preferred Contact Method">
        <option>Email</option>
        <option>Phone</option>
      </select>

      <div class="form-section-title">Project Information</div>
      <label for="type">Project Type *</label>
      <select id="type" name="Project Type" required>
        <option value="" selected disabled>Select project type</option>
        <option>New Home</option>
        <option>Home Addition</option>
        <option>Renovation / Remodel</option>
        <option>Commercial</option>
        <option>Interior Design</option>
        <option>Construction Documents</option>
        <option>3D Rendering</option>
        <option>Consultation</option>
        <option>Other</option>
      </select>

      <label for="street">Project Address *</label>
      <input id="street" name="Project Street Address" autocomplete="street-address" placeholder="Street address" required />

      <div class="form-row">
        <div>
          <label for="city">City *</label>
          <input id="city" name="Project City" autocomplete="address-level2" required />
        </div>
        <div>
          <label for="state">State *</label>
          <select id="state" name="Project State" autocomplete="address-level1" required>
            <option value="" selected disabled>Select state</option>
            <option>Maryland</option>
            <option>Virginia</option>
            <option>Washington, DC</option>
            <option>Other</option>
          </select>
        </div>
        <div>
          <label for="zip">ZIP Code *</label>
          <input id="zip" name="Project ZIP Code" inputmode="numeric" autocomplete="postal-code" pattern="[0-9]{5}(-[0-9]{4})?" placeholder="ZIP code" required />
        </div>
      </div>

      <label for="stage">Project Stage</label>
      <select id="stage" name="Project Stage">
        <option>Just exploring ideas</option>
        <option>Have a concept</option>
        <option>Ready to begin design</option>
        <option>Need construction documents</option>
        <option>Preparing for permitting</option>
        <option>Already have a contractor</option>
      </select>

      <div class="form-row">
        <div>
          <label for="budget">Approximate Project Budget</label>
          <select id="budget" name="Approximate Project Budget">
            <option>Not sure yet</option>
            <option>Under $100,000</option>
            <option>$100,000–$250,000</option>
            <option>$250,000–$500,000</option>
            <option>$500,000–$1M</option>
            <option>$1M+</option>
          </select>
        </div>
        <div>
          <label for="timeline">Desired Timeline</label>
          <select id="timeline" name="Desired Timeline">
            <option>Just researching</option>
            <option>As soon as possible</option>
            <option>Within 1–3 months</option>
            <option>3–6 months</option>
            <option>6+ months</option>
          </select>
        </div>
      </div>

      <label for="scope">Tell us about the project *</label>
      <textarea id="scope" name="Project Details" required placeholder="Describe the property, goals, approximate size and what you need designed."></textarea>

      <label for="files">Plans, Photos or Documents</label>
      <input id="files" name="Attachments" type="file" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" multiple />
      <p class="form-note">You may attach existing plans, surveys, photos, sketches or other project documents.</p>

      <div class="honeypot" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="Website" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit">Request a Project Consultation</button>
    </form>
  </div>
</section>

<style>
.contact-form{display:flex;flex-direction:column;gap:10px}
.contact-form label{font-size:13px;font-weight:600;color:var(--ink);margin-top:7px}
.contact-form input,.contact-form select,.contact-form textarea{width:100%;border:1px solid var(--line);background:#fff;color:var(--ink);font:inherit;padding:13px 14px;border-radius:0;box-sizing:border-box}
.contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{outline:2px solid rgba(155,28,28,.22);outline-offset:1px;border-color:#999}
.contact-form textarea{min-height:170px;resize:vertical;line-height:1.55}
.contact-form input[type=file]{padding:11px;background:#fafafa}
.contact-form button{margin-top:12px;border:0;background:#1f2428;color:#fff;padding:15px 20px;font:600 14px/1.2 inherit;cursor:pointer;letter-spacing:.01em}
.contact-form button:hover{background:#111}
.form-section-title{font:600 22px/1.2 Manrope;margin:22px 0 2px;padding-bottom:9px;border-bottom:1px solid var(--line)}
.form-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px}
.form-row>div{min-width:0}
.form-note{font-size:13px!important;line-height:1.55;color:#666;margin-top:12px}
.honeypot{position:absolute!important;left:-9999px;width:1px;height:1px;overflow:hidden}
@media(max-width:760px){.form-row{grid-template-columns:1fr}.contact-form{gap:8px}.form-section-title{margin-top:18px}}
</style>
</Layout>
