---
import Layout from "../layouts/Layout.astro";
const projects=[
 {name:"Anderson Residence",type:"Residential Architecture",image:"https://static.wixstatic.com/media/fb4db5_fe9b40835e04481ba3d1ab7fbf6d94a9~mv2_d_2979_3929_s_4_2.jpg/v1/fill/w_1200,h_800,al_c,q_90,enc_auto/fb4db5_fe9b40835e04481ba3d1ab7fbf6d94a9~mv2_d_2979_3929_s_4_2.jpg",description:"A new two-story home with a strong entry sequence and a majestic two-level entry porch."},
 {name:"McNeill Residence",type:"Residential Architecture",image:"https://static.wixstatic.com/media/fb4db5_f3b2ed31ce824ac2be3520f031e3eef4~mv2_d_5312_2988_s_4_2.jpeg/v1/fill/w_1200,h_800,al_c,q_90,enc_auto/fb4db5_f3b2ed31ce824ac2be3520f031e3eef4~mv2_d_5312_2988_s_4_2.jpeg",description:"An extensive kitchen extension and redesign with contemporary cabinetry, generous counters, natural light and a formal dining area."},
 {name:"Turner Residence",type:"Residential Architecture",image:"https://static.wixstatic.com/media/fb4db5_91524b19d9b147ad8499291e67e7d1bf~mv2.jpg/v1/fill/w_1200,h_800,al_c,q_90,enc_auto/fb4db5_91524b19d9b147ad8499291e67e7d1bf~mv2.jpg",description:"Residential design work featured in ATECT's construction-photo portfolio."},
 {name:"The Lis–Perlis Residence",type:"Residential Architecture",image:"https://atectarchitecture.com/assets/images/image05.jpg?v=5bc6d0ed",description:"A two-phase project in Chevy Chase: a redesigned front entry followed by a second-story sunroom capturing southern rear views."},
 {name:"Mariner Finance",type:"Commercial Design & Construction Documents",image:"https://static.wixstatic.com/media/9aae58f8cb39c0432380467cfa4e74eb.jpg/v1/fill/w_1200,h_800,al_c,q_90,enc_auto/9aae58f8cb39c0432380467cfa4e74eb.jpg",description:"Construction documents for interior fit-outs in Waldorf, Maryland and Richmond, Virginia, including ADA requirements, breakroom planning, bathroom improvements, a Hi-lo drinking fountain, project coordination and permitting support."}
];
---
<Layout title="Projects | ATECT Architecture" description="Selected residential and commercial architecture projects from ATECT Architecture, including residential design and the Mariner Finance commercial fit-out work.">
<section class="page-hero"><div class="eyebrow">Selected Work</div><h1>Projects shaped by place and purpose.</h1><p>Selected projects from ATECT's existing portfolio, presented with original project descriptions and available ATECT imagery.</p></section>
<section class="section"><div class="portfolio-grid">{projects.map((project,index)=><article class={index===0?"portfolio-card featured":"portfolio-card"}><div class="portfolio-image" style={`background-image:url('${project.image}')`} role="img" aria-label={`${project.name} project image`}></div><div class="project-copy"><div class="eyebrow">{project.type}</div><h2>{project.name}</h2><p>{project.description}</p></div></article>)}</div></section>
<section class="section alt"><div class="section-head"><div><div class="eyebrow">Explore by type</div><h2>More ATECT work.</h2></div><p class="section-intro">See residential design, commercial work and custom home plans in focused collections.</p></div><div class="button-row"><a class="button dark" href="/projects/residential">Residential Projects</a><a class="button" href="/projects/commercial">Commercial Projects</a><a class="button" href="/projects/custom-homes">Custom Home Plans</a></div></section>
</Layout>
<style is:global>.portfolio-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.portfolio-card{border:1px solid #ddd;background:#fff}.portfolio-card.featured{grid-column:1/-1;display:grid;grid-template-columns:1.4fr .6fr}.portfolio-image{aspect-ratio:4/3;background-size:cover;background-position:center}.featured .portfolio-image{aspect-ratio:auto;min-height:420px}.project-copy{padding:28px}.project-copy h2{font:600 clamp(27px,4vw,45px)/1.05 Manrope;margin:0 0 12px}.project-copy p{color:#555;line-height:1.7}.button-row{display:flex;flex-wrap:wrap;gap:12px}@media(max-width:800px){.portfolio-grid{grid-template-columns:1fr}.portfolio-card.featured{grid-column:auto;display:block}.featured .portfolio-image{min-height:0;aspect-ratio:4/3}.button-row{flex-direction:column;align-items:flex-start}}</style>
