---
import Layout from "../layouts/Layout.astro";

const slideshow = [
  { image: "https://static.wixstatic.com/media/fb4db5_5dc3a057ee8c45c497ab0239f3dad090~mv2_d_3840_2160_s_2.jpeg/v1/fill/w_1600,h_1000,al_c,q_90,enc_auto/fb4db5_5dc3a057ee8c45c497ab0239f3dad090~mv2_d_3840_2160_s_2.jpeg", alt: "Interior Kitchen Design" },
  { image: "https://static.wixstatic.com/media/64a3fe0da1474483894728ce5270545a.jpg/v1/fill/w_1600,h_1000,al_c,q_90,enc_auto/64a3fe0da1474483894728ce5270545a.jpg", alt: "Bright and Modern Kitchen" },
  { image: "https://static.wixstatic.com/media/071c77d7707a470991d5a3fdc0e57464.jpg/v1/fill/w_1600,h_1000,al_c,q_90,enc_auto/071c77d7707a470991d5a3fdc0e57464.jpg", alt: "White Bedroom" },
  { image: "https://static.wixstatic.com/media/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png/v1/fill/w_1600,h_1000,al_c,q_95,enc_auto/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png", alt: "Prairie View Residence" },
  { image: "https://static.wixstatic.com/media/fb4db5_6aa1b4210c184d92b564dca830787c38~mv2.png/v1/fill/w_1600,h_1000,al_c,q_95,enc_auto/fb4db5_6aa1b4210c184d92b564dca830787c38~mv2.png", alt: "Dunk Residence" },
  { image: "https://static.wixstatic.com/media/fb4db5_d7a6e831130f4889af5df4dce717a37f~mv2.png/v1/fill/w_1600,h_1000,al_c,q_95,enc_auto/fb4db5_d7a6e831130f4889af5df4dce717a37f~mv2.png", alt: "Eco Interior" },
  { image: "https://static.wixstatic.com/media/9aae58f8cb39c0432380467cfa4e74eb.jpg/v1/fill/w_1600,h_1000,al_c,q_90,enc_auto/9aae58f8cb39c0432380467cfa4e74eb.jpg", alt: "Blueprint Design" }
];

const constructionPhotos = [
  { image: "https://static.wixstatic.com/media/fb4db5_fe9b40835e04481ba3d1ab7fbf6d94a9~mv2_d_2979_3929_s_4_2.jpg/v1/fill/w_1400,h_1580,al_c,q_90,enc_auto/fb4db5_fe9b40835e04481ba3d1ab7fbf6d94a9~mv2_d_2979_3929_s_4_2.jpg", alt: "The Anderson Residence", description: "Residential design and construction showcasing the architectural character, detailing and finished quality of the Anderson Residence." },
  { image: "https://static.wixstatic.com/media/fb4db5_f3b2ed31ce824ac2be3520f031e3eef4~mv2_d_5312_2988_s_4_2.jpeg/v1/fill/w_1600,h_900,al_c,q_90,enc_auto/fb4db5_f3b2ed31ce824ac2be3520f031e3eef4~mv2_d_5312_2988_s_4_2.jpeg", alt: "The McNeill Residence — View 1", description: "A construction view of the McNeill Residence highlighting the relationship between the architectural design, exterior form and completed building." },
  { image: "https://static.wixstatic.com/media/fb4db5_fc8cf9a2735a487aa19915078017e397~mv2_d_5312_2988_s_4_2.jpeg/v1/fill/w_1600,h_900,al_c,q_90,enc_auto/fb4db5_fc8cf9a2735a487aa19915078017e397~mv2_d_5312_2988_s_4_2.jpeg", alt: "The McNeill Residence — View 2", description: "Another perspective of the McNeill Residence illustrating the exterior architecture, proportions and project detailing developed through the design process." },
  { image: "https://s3-media0.fl.yelpcdn.com/bphoto/d7cdM7MtNSSbdQP1kGSQOA/o.jpg", alt: "The McNeill Residence — View 3", description: "A third project view providing additional context for the McNeill Residence and the architectural design as experienced from the exterior." },
  { image: "https://static.wixstatic.com/media/fb4db5_b1322784beec46bdbc99f8c034c8491d~mv2.jpg/v1/fill/w_1600,h_900,al_c,q_90,enc_auto/fb4db5_b1322784beec46bdbc99f8c034c8491d~mv2.jpg", alt: "Swan Point Residence", description: "Residential architecture designed to respond to its waterfront setting, connecting the home’s form and outdoor spaces with the surrounding landscape." },
  { image: "https://static.wixstatic.com/media/fb4db5_91524b19d9b147ad8499291e67e7d1bf~mv2.jpg/v1/fill/w_1400,h_930,al_c,q_90,enc_auto/fb4db5_91524b19d9b147ad8499291e67e7d1bf~mv2.jpg", alt: "The Turner Residence", description: "A residential project demonstrating how architectural planning and construction documentation translate into a finished, functional home." }
];
---

<Layout title="ATECT Architecture | Residential & Commercial Design Firm" description="Architectural design services servicing the Maryland, DC & Virginia area.">
  <section class="hero-slider" aria-label="ATECT Architecture portfolio slideshow">
    {slideshow.map((slide, index) => (
      <div class:list={["hero-slide", index === 0 && "active"]} data-slide={index}>
        <img src={slide.image} alt={slide.alt} loading={index === 0 ? "eager" : "lazy"} />
      </div>
    ))}
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="eyebrow">ATECT Architecture</div>
      <h1>The Design Solution</h1>
      <p>Architectural design services servicing Maryland, Washington, DC & Virginia.</p>
      <a class="button" href="/contact">Start a Project</a>
    </div>
    <div class="slider-dots" aria-label="Slideshow controls">
      {slideshow.map((slide, index) => (
        <button class:list={["slider-dot", index === 0 && "active"]} type="button" data-dot={index} aria-label={`Show slide ${index + 1}`}></button>
      ))}
    </div>
  </section>

  <section class="section construction-section">
    <div class="section-head">
      <div><h2>PROJECT CONSTRUCTION PHOTOS</h2></div>
    </div>
    <div class="construction-accordion" aria-label="Project Construction Photos">
      {constructionPhotos.map((photo, index) => (
        <button class:list={["construction-panel", index === 0 && "active"]} type="button" data-panel={index} aria-label={`View ${photo.alt}`}>
          <img src={photo.image} alt={photo.alt} loading={index < 2 ? "eager" : "lazy"} />
          <span class="panel-shade"></span>
          <span class="panel-copy">
            <span class="panel-label">{photo.alt}</span>
            <span class="panel-description">{photo.description}</span>
          </span>
        </button>
      ))}
    </div>
  </section>

  <section class="feature">
    <div class="feature-image" style={`background-image:url('${slideshow[3].image}')`} role="img" aria-label="ATECT project image"></div>
    <div class="feature-copy"><div class="eyebrow">The ATECT Approach</div><h2>From idea to construction documents.</h2><p>ATECT balances comfort, practicality and beauty while carrying projects from design development into construction documentation and coordination.</p><a class="button" href="/process">Explore the Process</a></div>
  </section>

  <section class="section">
    <div class="section-head"><div><div class="eyebrow">Why ATECT</div><h2>Design clarity matters.</h2></div><p class="section-intro">ATECT was founded in 2004 with an approach centered on comfort, practicality and beauty.</p></div>
    <div class="stat-grid"><div class="stat"><strong>01</strong><span>Understand the property and goals</span></div><div class="stat"><strong>02</strong><span>Develop the design with intention</span></div><div class="stat"><strong>03</strong><span>Document the solution clearly</span></div></div>
  </section>

  <section class="section cta-section"><div class="eyebrow">Next Step</div><h2>Have a project in mind?</h2><p class="section-intro">Let's talk about your property, goals and vision.</p><a class="button dark" href="/contact">Start Your Project</a></section>
</Layout>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero-slide'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.slider-dot'));
  const panels = Array.from(document.querySelectorAll<HTMLButtonElement>('.construction-panel'));
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  const showSlide = (index: number) => {
    current = (index + slides.length) % slides.length;
    slides.forEach((slide, i) => slide.classList.toggle('active', i === current));
    dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
  };

  const startTimer = () => {
    clearInterval(timer);
    timer = setInterval(() => showSlide(current + 1), 5500);
  };

  dots.forEach((dot, index) => dot.addEventListener('click', () => {
    showSlide(index);
    startTimer();
  }));

  panels.forEach((panel, index) => {
    panel.addEventListener('mouseenter', () => panels.forEach((item, i) => item.classList.toggle('active', i === index)));
    panel.addEventListener('focus', () => panels.forEach((item, i) => item.classList.toggle('active', i === index)));
    panel.addEventListener('click', () => panels.forEach((item, i) => item.classList.toggle('active', i === index)));
  });

  startTimer();
</script>

<style is:global>
  .hero-slider{position:relative;height:calc(100vh - 88px);min-height:620px;overflow:hidden;background:#111;color:#fff}
  .hero-slide{position:absolute;inset:0;opacity:0;transition:opacity 1.1s ease;z-index:0}
  .hero-slide.active{opacity:1}
  .hero-slide img{width:100%;height:100%;display:block;object-fit:cover;object-position:center}
  .hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.62),rgba(0,0,0,.12) 65%,rgba(0,0,0,.18));z-index:1}
  .hero-content{position:absolute;left:clamp(24px,7vw,100px);bottom:clamp(60px,10vw,125px);max-width:800px;z-index:2;color:#fff}
  .hero-content h1{font:600 clamp(48px,8vw,105px)/.96 Manrope;margin:0 0 24px;letter-spacing:-.045em}
  .hero-content p{font-size:clamp(17px,2vw,22px);max-width:690px;color:#eee;margin:0}
  .slider-dots{position:absolute;left:clamp(24px,7vw,100px);bottom:28px;display:flex;gap:8px;z-index:3}
  .slider-dot{width:28px;height:3px;padding:0;border:0;background:rgba(255,255,255,.45);cursor:pointer;transition:width .25s ease,background .25s ease}
  .slider-dot.active{width:48px;background:#fff}
  .construction-section{padding-top:70px;padding-bottom:90px}
  .construction-accordion{display:flex;width:100%;height:min(560px,56vw);min-height:390px;gap:6px;overflow:hidden}
  .construction-panel{position:relative;flex:1 1 0;min-width:0;height:100%;padding:0;border:0;border-radius:0;background:#f0f0ed;overflow:hidden;cursor:pointer;text-align:left;transition:flex-grow .55s cubic-bezier(.22,.61,.36,1),background .3s ease}
  .construction-panel:hover,.construction-panel:focus-visible,.construction-panel.active{flex-grow:4}
  .construction-panel img{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover;object-position:center;transition:transform .55s ease,opacity .3s ease}
  .construction-panel:hover img,.construction-panel:focus-visible img,.construction-panel.active img{object-fit:contain;transform:scale(1);background:#f0f0ed}
  .construction-panel:not(:hover):not(:focus-visible):not(.active) img{transform:scale(1.01)}
  .panel-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 38%,rgba(0,0,0,.82));opacity:.58;pointer-events:none;transition:opacity .35s ease}
  .construction-panel:hover .panel-shade,.construction-panel:focus-visible .panel-shade,.construction-panel.active .panel-shade{opacity:.42}
  .panel-copy{position:absolute;left:20px;right:20px;bottom:18px;color:#fff;display:flex;flex-direction:column;align-items:flex-start;gap:8px;z-index:2;pointer-events:none;text-shadow:0 1px 4px rgba(0,0,0,.55)}
  .panel-label{font:600 13px/1.25 Manrope;letter-spacing:.05em;text-transform:uppercase;opacity:0;transform:translateY(10px);transition:opacity .3s ease,transform .3s ease}
  .panel-description{max-width:700px;font:400 14px/1.55 Manrope;letter-spacing:0;text-transform:none;opacity:0;transform:translateY(10px);transition:opacity .35s ease .04s,transform .35s ease .04s}
  .construction-panel:hover .panel-label,.construction-panel:focus-visible .panel-label,.construction-panel.active .panel-label,.construction-panel:hover .panel-description,.construction-panel:focus-visible .panel-description,.construction-panel.active .panel-description{opacity:1;transform:translateY(0)}
  .construction-panel:focus-visible{outline:3px solid #111;outline-offset:-3px}
  .cta-section{background:#f5f5f2}
  @media(max-width:800px){
    .hero-slider{height:78vh;min-height:540px}
    .hero-content{left:24px;right:24px;bottom:70px}
    .hero-content h1{font-size:clamp(44px,13vw,70px)}
    .slider-dots{left:24px;bottom:25px}
    .hero-overlay{background:linear-gradient(90deg,rgba(0,0,0,.64),rgba(0,0,0,.2))}
    .construction-section{padding-top:50px;padding-bottom:65px}
    .construction-accordion{height:72vw;min-height:340px;max-height:480px;gap:4px}
    .construction-panel:hover,.construction-panel:focus-visible,.construction-panel.active{flex-grow:6}
    .panel-copy{left:14px;right:14px;bottom:14px;gap:6px}
    .panel-label{font-size:11px}
    .panel-description{font-size:12px;line-height:1.45}
  }
  @media(prefers-reduced-motion:reduce){.hero-slide,.construction-panel,.construction-panel img,.panel-label,.panel-description{transition:none}.hero-slider .hero-slide{opacity:1}.hero-slider .hero-slide:not(:first-child){display:none}}
</style>
