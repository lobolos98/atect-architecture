---
import Layout from "../layouts/Layout.astro";
const projects = [
  {name:"Perlis Residence", type:"Residential Architecture", image:"https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1400&q=85"},
  {name:"McNeill Residence", type:"Residential Architecture", image:"https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1400&q=85"},
  {name:"Mariner Finance", type:"Commercial Design", image:"https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=1400&q=85"}
];
---
<Layout title="ATECT Architecture | Residential & Commercial Design Firm" description="ATECT Architecture provides residential and commercial architectural design services throughout Maryland, Washington, DC, and Virginia.">
  <section class="hero"><div class="hero-content"><div class="eyebrow">ATECT Architecture</div><h1>Architecture designed with purpose.</h1><p>Residential and commercial design solutions shaped around your property, your goals and the way you intend to use the space.</p><a class="button" href="/contact">Start a Project</a></div></section>

  <section class="section"><div class="section-head"><div><div class="eyebrow">Selected Work</div><h2>Designed for how you live, work & build.</h2></div><p class="section-intro">Thoughtful architecture combines practical planning, strong design and construction-ready documentation.</p></div><div class="grid">{projects.map((project) => <a class="card" href="/projects"><div class="project-image" style={`background-image:url('${project.image}')`} role="img" aria-label={`${project.name} project image`}></div><div class="project-copy"><h3>{project.name}</h3><p>{project.type}</p><span class="project-link">View project work →</span></div></a>)}</div></section>

  <section class="feature"><div class="feature-image" role="img" aria-label="Contemporary residential architecture"></div><div class="feature-copy"><div class="eyebrow">The ATECT Approach</div><h2>From idea to construction documents.</h2><p>We connect design thinking with practical documentation so clients can make informed decisions before construction begins.</p><a class="button" href="/process">Explore the Process</a></div></section>

  <section class="section alt"><div class="section-head"><div><div class="eyebrow">Capabilities</div><h2>What we do.</h2></div><p class="section-intro">Design services for residential and commercial projects, from early concepts through detailed documentation.</p></div><div class="service-grid"><a class="service" href="/services#residential"><h3>Residential Architecture</h3><p>Custom homes, additions, renovations and residential design developed around each client's needs.</p><span>Explore residential →</span></a><a class="service" href="/services#commercial"><h3>Commercial Architecture</h3><p>Professional design solutions for commercial and business environments.</p><span>Explore commercial →</span></a><a class="service" href="/services#documents"><h3>Construction Documents</h3><p>Clear, coordinated documentation that communicates the design intent for permitting and construction.</p><span>View documentation services →</span></a><a class="service" href="/3d-renderings"><h3>3D Renderings & Visualization</h3><p>Three-dimensional visualization that helps clients understand the finished project before construction.</p><span>See visualization →</span></a></div></section>

  <section class="section"><div class="section-head"><div><div class="eyebrow">Why ATECT</div><h2>Design clarity matters.</h2></div><p class="section-intro">Good architecture is not only about how a project looks. It is about making the right decisions at the right time.</p></div><div class="stat-grid"><div class="stat"><strong>01</strong><span>Understand the property and goals</span></div><div class="stat"><strong>02</strong><span>Develop the design with intention</span></div><div class="stat"><strong>03</strong><span>Document the solution clearly</span></div></div></section>

  <section class="section cta-section"><div class="eyebrow">Next Step</div><h2>Have a project in mind?</h2><p class="section-intro">Let's talk about your property, goals and vision.</p><a class="button dark" href="/contact">Start Your Project</a></section>
</Layout>
<style is:global>.project-link,.service span{display:inline-block;margin-top:16px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.service{display:block}.cta-section{background:#f5f5f2}</style>
