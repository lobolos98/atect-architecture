---
import Layout from "../layouts/Layout.astro";
const projects = [
  {name:"Anderson Residence", type:"Residential Architecture", image:"https://static.wixstatic.com/media/fb4db5_fe9b40835e04481ba3d1ab7fbf6d94a9~mv2_d_2979_3929_s_4_2.jpg/v1/fill/w_1200,h_800,al_c,q_90,enc_auto/fb4db5_fe9b40835e04481ba3d1ab7fbf6d94a9~mv2_d_2979_3929_s_4_2.jpg"},
  {name:"McNeill Residence", type:"Residential Architecture", image:"https://static.wixstatic.com/media/fb4db5_f3b2ed31ce824ac2be3520f031e3eef4~mv2_d_5312_2988_s_4_2.jpeg/v1/fill/w_1200,h_800,al_c,q_90,enc_auto/fb4db5_f3b2ed31ce824ac2be3520f031e3eef4~mv2_d_5312_2988_s_4_2.jpeg"},
  {name:"Turner Residence", type:"Residential Architecture", image:"https://static.wixstatic.com/media/fb4db5_91524b19d9b147ad8499291e67e7d1bf~mv2.jpg/v1/fill/w_1200,h_800,al_c,q_90,enc_auto/fb4db5_91524b19d9b147ad8499291e67e7d1bf~mv2.jpg"},
  {name:"Mariner Finance", type:"Commercial Design & Construction Documents", image:"https://static.wixstatic.com/media/9aae58f8cb39c0432380467cfa4e74eb.jpg/v1/fill/w_1200,h_800,al_c,q_90,enc_auto/9aae58f8cb39c0432380467cfa4e74eb.jpg"}
];
---
<Layout title="ATECT Architecture | Residential & Commercial Design Firm" description="ATECT Architecture provides residential and commercial architectural design services throughout Maryland, Washington, DC, and Virginia.">
  <section class="hero"><div class="hero-content"><div class="eyebrow">ATECT Architecture</div><h1>Architecture designed with purpose.</h1><p>Residential and commercial design solutions shaped around your property, your goals and the way you intend to use the space.</p><a class="button" href="/contact">Start a Project</a></div></section>

  <section class="section"><div class="section-head"><div><div class="eyebrow">Selected Work</div><h2>Real ATECT projects.</h2></div><p class="section-intro">Selected residential and commercial work from the ATECT portfolio, using project imagery and descriptions from the firm's existing site.</p></div><div class="grid">{projects.map((project) => <a class="card" href="/projects"><div class="project-image" style={`background-image:url('${project.image}')`} role="img" aria-label={`${project.name} project image`}></div><div class="project-copy"><h3>{project.name}</h3><p>{project.type}</p><span class="project-link">View project work →</span></div></a>)}</div></section>

  <section class="feature"><div class="feature-image" style="background-image:url('https://atectarchitecture.com/assets/images/image05.jpg?v=5bc6d0ed')" role="img" aria-label="ATECT project construction photo"></div><div class="feature-copy"><div class="eyebrow">The ATECT Approach</div><h2>From idea to construction documents.</h2><p>ATECT's work balances comfort, practicality and beauty while carrying projects from design development into construction documentation and coordination.</p><a class="button" href="/process">Explore the Process</a></div></section>

  <section class="section alt"><div class="section-head"><div><div class="eyebrow">Capabilities</div><h2>What we do.</h2></div><p class="section-intro">ATECT's existing services include residential design, commercial construction documents, subcontracting support and 3D visualization.</p></div><div class="service-grid"><a class="service" href="/services"><h3>Residential Architecture</h3><p>Home additions, kitchen and bathroom renovations, decks, porches and new home design.</p><span>Explore residential →</span></a><a class="service" href="/services"><h3>Commercial Architecture</h3><p>Construction documents for commercial projects, interior fit-outs and related design work.</p><span>Explore commercial →</span></a><a class="service" href="/services"><h3>Construction Documents</h3><p>Design through the construction document phase for residential, commercial and as-built work.</p><span>View documentation services →</span></a><a class="service" href="/3d-renderings"><h3>3D Renderings & Visualization</h3><p>Exterior renderings, interior renderings, 360 panoramas and architectural animations.</p><span>See visualization →</span></a></div></section>

  <section class="section"><div class="section-head"><div><div class="eyebrow">Why ATECT</div><h2>Design clarity matters.</h2></div><p class="section-intro">ATECT was founded in 2004 with an approach centered on comfort, practicality, beauty and improving the experience of the people who use each space.</p></div><div class="stat-grid"><div class="stat"><strong>01</strong><span>Understand the property and goals</span></div><div class="stat"><strong>02</strong><span>Develop the design with intention</span></div><div class="stat"><strong>03</strong><span>Document the solution clearly</span></div></div></section>

  <section class="section cta-section"><div class="eyebrow">Next Step</div><h2>Have a project in mind?</h2><p class="section-intro">Let's talk about your property, goals and vision.</p><a class="button dark" href="/contact">Start Your Project</a></section>
</Layout>
<style is:global>.project-link,.service span{display:inline-block;margin-top:16px;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.service{display:block}.cta-section{background:#f5f5f2}</style>
