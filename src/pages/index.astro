  { image: "https://static.wixstatic.com/media/64a3fe0da1474483894728ce5270545a.jpg/v1/fill/w_1600,h_1000,al_c,q_90,enc_auto/64a3fe0da1474483894728ce5270545a.jpg", alt: "Bright and Modern Kitchen" },
  { image: "https://static.wixstatic.com/media/071c77d7707a470991d5a3fdc0e57464.jpg/v1/fill/w_1600,h_1000,al_c,q_90,enc_auto/071c77d7707a470991d5a3fdc0e57464.jpg", alt: "White Bedroom" },
  { image: "https://static.wixstatic.com/media/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png/v1/fill/w_1600,h_1000,al_c,q_95,enc_auto/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png", alt: "Prairie View Residence" },
  { image: "https://static.wixstatic.com/media/fb4db5_6aa1b4210c184d92b564dca830787c38~mv2.png/v1/fill/w_1600,h_1000,al_c,q_95,enc_auto/fb4db5_6aa1b4210c184d92b564dca830787c38~mv2.png", alt: "Dunk Residence" },
  { image: "https://static.wixstatic.com/media/fb4db5_d7a6e831130f4889af5df4dce717a37f~mv2.png/v1/fill/w_1600,h_1000,al_c,q_95,enc_auto/fb4db5_d7a6e831130f4889af5df4dce717a37f~mv2.png", alt: "Eco Interior" },
  { image: "https://static.wixstatic.com/media/9aae58f8cb39c0432380467cfa4e74eb.jpg/v1/fill/w_1600,h_1000,al_c,q_90,enc_auto/9aae58f8cb39c0432380467cfa4e74eb.jpg", alt: "Blueprint Design" }
];

const constructionPhotos = [
  { image: "https://static.wixstatic.com/media/fb4db5_fe9b40835e04481ba3d1ab7fbf6d94a9~mv2_d_2979_3929_s_4_2.jpg/v1/fill/w_1200,h_1580,al_c,q_90,enc_auto/fb4db5_fe9b40835e04481ba3d1ab7fbf6d94a9~mv2_d_2979_3929_s_4_2.jpg", alt: "The Anderson Residence" },
  { image: "https://static.wixstatic.com/media/fb4db5_f3b2ed31ce824ac2be3520f031e3eef4~mv2_d_5312_2988_s_4_2.jpeg/v1/fill/w_1400,h_780,al_c,q_90,enc_auto/fb4db5_f3b2ed31ce824ac2be3520f031e3eef4~mv2_d_5312_2988_s_4_2.jpeg", alt: "The McNeill Residence" },
  { image: "https://static.wixstatic.com/media/fb4db5_fc8cf9a2735a487aa19915078017e397~mv2_d_5312_2988_s_4_2.jpeg/v1/fill/w_1400,h_780,al_c,q_90,enc_auto/fb4db5_fc8cf9a2735a487aa19915078017e397~mv2_d_5312_2988_s_4_2.jpeg", alt: "The McNeill Residence" },
  { image: "https://static.wixstatic.com/media/fb4db5_fe9b40835e04481ba3d1ab7fbf6d94a9~mv2_d_2979_3929_s_4_2.jpg/v1/fill/w_1400,h_780,al_c,q_90,enc_auto/fb4db5_fe9b40835e04481ba3d1ab7fbf6d94a9~mv2_d_2979_3929_s_4_2.jpg", alt: "The McNeill Residence" },
  { image: "https://static.wixstatic.com/media/fb4db5_211d3940627c42669e8fe0ff0d90c325~mv2_d_5312_2988_s_4_2.jpeg/v1/fill/w_1400,h_780,al_c,q_90,enc_auto/fb4db5_211d3940627c42669e8ff0d90c325~mv2_d_5312_2988_s_4_2.jpeg", alt: "The McNeill Residence" },
  { image: "https://static.wixstatic.com/media/fb4db5_b1322784beec46bdbc99f8c034c8491d~mv2.jpg/v1/fill/w_1400,h_780,al_c,q_90,enc_auto/fb4db5_b1322784beec46bdbc99f8c034c8491d~mv2.jpg", alt: "The McNeill Residence" },
  { image: "https://static.wixstatic.com/media/fb4db5_91524b19d9b147ad8499291e67e7d1bf~mv2.jpg/v1/fill/w_1400,h_930,al_c,q_90,enc_auto/fb4db5_91524b19d9b147ad8499291e67e7d1bf~mv2.jpg", alt: "The Turner Residence" }
];
---

<Layout title="ATECT Architecture | Residential & Commercial Design Firm" description="Architectural design services servicing the Maryland, DC & Virginia area.">
  <section class="hero-slider" aria-label="ATECT Architecture portfolio slideshow">
    {slideshow.map((slide, index) => (
      <div class:list={["hero-slide", index === 0 && "active"]} data-slide={index}><img src={slide.image} alt={slide.alt} loading={index === 0 ? "eager" : "lazy"} /></div>
    ))}
    <div class="hero-overlay"></div>
    <div class="hero-content"><div class="eyebrow">ATECT Architecture</div><h1>The Design Solution</h1><p>Architectural design services servicing Maryland, Washington, DC & Virginia.</p><a class="button" href="/contact">Start a Project</a></div>
    <div class="slider-dots" aria-label="Slideshow controls">
      {slideshow.map((slide, index) => <button class:list={["slider-dot", index === 0 && "active"]} type="button" data-dot={index} aria-label={`Show slide ${index + 1}`}></button>)}
    </div>
  </section>

  <section class="section construction-section">
    <div class="section-head">
      <div><div class="eyebrow">Portfolio</div><h2>PROJECT CONSTRUCTION PHOTOS</h2></div>
    </div>
    <div class="construction-accordion" aria-label="Project Construction Photos">
      {constructionPhotos.map((photo, index) => (
        <button class:list={["construction-panel", index === 0 && "active"]} type="button" data-panel={index} aria-label={`View ${photo.alt}`}>
          <img src={photo.image} alt={photo.alt} loading={index === 0 ? "eager" : "lazy"} />
          <span class="panel-shade"></span>
          <span class="panel-label">{photo.alt}</span>
        </button>
      ))}
    </div>
  </section>

  <section class="feature"><div class="feature-image" style={`background-image:url('${slideshow[3].image}')`} role="img" aria-label="ATECT project image"></div><div class="feature-copy"><div class="eyebrow">The ATECT Approach</div><h2>From idea to construction documents.</h2><p>ATECT balances comfort, practicality and beauty while carrying projects from design development into construction documentation and coordination.</p><a class="button" href="/process">Explore the Process</a></div></section>

  <section class="section"><div class="section-head"><div><div class="eyebrow">Why ATECT</div><h2>Design clarity matters.</h2></div><p class="section-intro">ATECT was founded in 2004 with an approach centered on comfort, practicality and beauty.</p></div><div class="stat-grid"><div class="stat"><strong>01</strong><span>Understand the property and goals</span></div><div class="stat"><strong>02</strong><span>Develop the design with intention</span></div><div class="stat"><strong>03</strong><span>Document the solution clearly</span></div></div></section>

  <section class="section cta-section"><div class="eyebrow">Next Step</div><h2>Have a project in mind?</h2><p class="section-intro">Let's talk about your property, goals and vision.</p><a class="button dark" href="/contact">Start Your Project</a></section>
</Layout>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero-slide'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.slider-dot'));
  const panels = Array.from(document.querySelectorAll<HTMLButtonElement>('.construction-panel'));
  let current = 0;
  let timer: ReturnType<typeof setInterval>;

  const showSlide = (index: number) => {
    current = (index + slides.length) % slides.length;
    slides.forEach((slide, i) => slide.classList.toggle('active', i === current));
    dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
  };

  const startTimer = () => {
    clearInterval(timer);
    timer = setInterval(() => showSlide(current + 1), 5500);
  };

  dots.forEach((dot, index) => dot.addEventListener('click', () => {
    showSlide(index);
    startTimer();
</script>

<style is:global>
  .hero-slider{position:relative;height:calc(100vh - 88px);min-height:620px;overflow:hidden;background:#111;color:#fff}.hero-slide{position:absolute;inset:0;opacity:0;transition:opacity 1.1s ease;z-index:0}.hero-slide.active{opacity:1}.hero-slide img{width:100%;height:100%;display:block;object-fit:cover;object-position:center}.hero-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.62),rgba(0,0,0,.12) 65%,rgba(0,0,0,.18));z-index:1}.hero-content{position:absolute;left:clamp(24px,7vw,100px);bottom:clamp(60px,10vw,125px);max-width:800px;z-index:2;color:#fff}.hero-content h1{font:600 clamp(48px,8vw,105px)/.96 Manrope;margin:0 0 24px;letter-spacing:-.045em}.hero-content p{font-size:clamp(17px,2vw,22px);max-width:690px;color:#eee;margin:0}.slider-dots{position:absolute;left:clamp(24px,7vw,100px);bottom:28px;display:flex;gap:8px;z-index:3}.slider-dot{width:28px;height:3px;padding:0;border:0;background:rgba(255,255,255,.45);cursor:pointer;transition:width .25s ease,background .25s ease}.slider-dot.active{width:48px;background:#fff}
  .construction-section{padding-top:70px;padding-bottom:90px}
  .construction-accordion{display:flex;width:100%;height:min(520px,58vw);min-height:360px;gap:5px;overflow:hidden}
  .construction-panel{position:relative;flex:1 1 0;min-width:0;padding:0;border:0;background:#111;overflow:hidden;cursor:pointer;transition:flex-grow .65s cubic-bezier(.22,.61,.36,1);text-align:left}
  .construction-panel.active{flex-grow:4}
  .construction-panel img{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover;object-position:center;transition:transform .65s ease}
  .construction-panel:hover img,.construction-panel.active img{transform:scale(1.015)}
  .panel-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.05),rgba(0,0,0,.52));opacity:.7;transition:opacity .4s ease}
  .construction-panel.active .panel-shade{opacity:.45}
  .panel-label{position:absolute;left:20px;bottom:20px;color:#fff;font:600 13px/1.2 Manrope;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap;opacity:0;transform:translateY(10px);transition:opacity .35s ease,transform .35s ease}
  .construction-panel.active .panel-label{opacity:1;transform:translateY(0)}
  .cta-section{background:#f5f5f2}
  @media(max-width:900px){
    .hero-slider{height:78vh;min-height:540px}.hero-content{left:24px;right:24px;bottom:70px}.hero-content h1{font-size:clamp(44px,13vw,70px)}.slider-dots{left:24px;bottom:25px}.hero-overlay{background:linear-gradient(90deg,rgba(0,0,0,.64),rgba(0,0,0,.2))}
    .construction-section{padding-top:50px;padding-bottom:50px}.construction-accordion{display:block;height:auto!important;min-height:0!important;overflow:hidden;position:relative;background:#fff}.construction-panel,.construction-panel:hover,.construction-panel:focus-visible,.construction-panel.active{display:none!important;position:absolute!important;inset:0 auto auto 0!important;flex:none!important;width:100%!important;height:auto!important;min-height:0!important;margin:0!important;background:#fff!important;overflow:hidden;box-shadow:none;outline:none;opacity:0;visibility:hidden;transform:translateX(24px);pointer-events:none;transition:opacity .35s ease,transform .35s ease,visibility 0s linear .35s!important}.construction-panel.active{display:block!important;position:relative!important;width:100%!important;height:auto!important;min-height:0!important;max-height:none!important;opacity:1;visibility:visible;transform:translateX(0);pointer-events:auto;transition:opacity .35s ease,transform .35s ease!important}.construction-panel img,.construction-panel:hover img,.construction-panel:focus-visible img,.construction-panel.active img{position:relative;inset:auto;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover!important;object-position:center;display:block;transform:none!important;background:#f0f0ed}.panel-shade,.construction-panel:hover .panel-shade,.construction-panel:focus-visible .panel-shade,.construction-panel.active .panel-shade{display:none!important}.panel-copy,.construction-panel:hover .panel-copy,.construction-panel:focus-visible .panel-copy,.construction-panel.active .panel-copy{position:relative;left:auto;right:auto;bottom:auto;padding:8px 2px 2px;color:#111;display:flex;flex-direction:column;align-items:flex-start;gap:6px;text-shadow:none;pointer-events:none;transform:none}.panel-label,.construction-panel:hover .panel-label,.construction-panel:focus-visible .panel-label,.construction-panel.active .panel-label{font:600 12px/1.3 Manrope;letter-spacing:.06em;text-transform:uppercase;color:#111;opacity:1;transform:none}.panel-description,.construction-panel:hover .panel-description,.construction-panel:focus-visible .panel-description,.construction-panel.active .panel-description{max-width:none;font:400 14px/1.6 Manrope;color:#666;opacity:1;transform:none}.construction-mobile-controls{display:flex;align-items:center;justify-content:space-between;margin-top:6px;padding-top:6px;border-top:1px solid #ddd}.construction-arrow{width:42px;height:42px;border:1px solid #bbb;border-radius:50%;background:#fff;color:#111;font-size:28px;line-height:1;display:grid;place-items:center;cursor:pointer}.construction-arrow:active{background:#111;color:#fff}.construction-counter{font:600 11px/1 Manrope;letter-spacing:.12em;color:#666;text-transform:uppercase}.construction-section .section-head{margin-bottom:24px}
  }
  @media(prefers-reduced-motion:reduce){.hero-slide,.construction-panel,.construction-panel img,.panel-label,.panel-description{transition:none}.hero-slider .hero-slide{opacity:1}.hero-slider .hero-slide:not(:first-child){display:none}}
</style>