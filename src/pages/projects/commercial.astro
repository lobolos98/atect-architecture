  { src: "https://static.wixstatic.com/media/c990e5_6b289c5c72914310a606f707bf30b5ab~mv2_d_4160_3120_s_4_2.jpg", alt: "Mariner Finance commercial project" },
  { src: "https://static.wixstatic.com/media/fb4db5_3a489ea0b1fb4310904d0c007af6366a~mv2_d_2592_1728_s_2.jpg", alt: "Waldorf construction documents" },
  { src: "https://static.wixstatic.com/media/fb4db5_69afbc26db9943ae81b520804a8b193b~mv2_d_2592_1728_s_2.jpg", alt: "Waldorf construction documents" },
  { src: "https://static.wixstatic.com/media/fb4db5_e145a26783174cadac96901da0d26cb1~mv2_d_2592_1728_s_2.jpg", alt: "Waldorf construction documents" },
  { src: "https://static.wixstatic.com/media/fb4db5_10e2854943764203b0eb1f2769e9bee0~mv2_d_2592_1728_s_2.jpg", alt: "Waldorf construction documents" },
