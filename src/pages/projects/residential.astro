---

<Layout title="Residential Projects | ATECT Architecture" description="Residential architecture projects by ATECT Architecture in Maryland, Washington DC and Virginia.">
<main>
<section class="hero"><div class="eyebrow">Residential Projects</div><h1>Our Residential Work</h1><p>Explore the residential projects of ATECT Architecture, including renovations, additions and new-home design throughout Maryland and the Washington, DC area.</p></section>
<section class="projects" aria-label="Residential project galleries">
{projects.map((project, i) => (
<article class="project" id={`project-${i+1}`}>
<header><div><span class="number">{String(i+1).padStart(2,"0")}</span><h2>{project.name}</h2>{project.location && <p class="location">{project.location}</p>}</div><div class="scope"><span>Scope of Work</span><p>{project.scope}</p></div></header>
<div class="slider" data-slider={i} tabindex="0">
<div class="slides">{project.images.map((image,j)=><img class:list={{active:j===0}} data-slide={j} src={image} alt={`${project.title} — project image ${j+1}`} loading={i===0&&j===0?"eager":"lazy"} />)}</div>
<button class="arrow prev" type="button" data-prev aria-label="Previous image">‹</button><button class="arrow next" type="button" data-next aria-label="Next image">›</button>
<div class="slider-tools"><span class="counter" data-counter>1 / {project.images.length}</span><button class="fullscreen" type="button" data-fullscreen>View Fullscreen</button></div>
<div class="thumbs">{project.images.map((image,j)=><button type="button" class:list={{active:j===0}} data-thumb={j} aria-label={`View image ${j+1}`}><img src={image} alt="" loading="lazy" /></button>)}</div>
</div>
</article>
))}
</section>
<section class="cta"><div><span class="eyebrow">Start a Project</span><h2>Let's design something that works.</h2><p>Tell us about your residential project and the goals you have for the space.</p></div><a class="button" href="/contact">Contact ATECT</a></section>
</main>
</Layout>

<style>
.hero{padding:46px clamp(24px,7vw,100px) 36px;background:var(--paper);border-bottom:1px solid var(--line)}
.hero .eyebrow{margin-bottom:10px}.hero h1{font:600 clamp(46px,7vw,78px)/.95 Manrope;letter-spacing:-.05em;max-width:900px;margin:0}.hero p{max-width:760px;margin:14px 0 0;font-size:17px;line-height:1.55;color:var(--muted)}
.projects{max-width:1500px;margin:0 auto;padding:30px clamp(18px,4vw,60px) 100px}.project{padding:42px 0 70px;border-bottom:1px solid var(--line)}.project:last-child{border-bottom:0}.project header{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:end;margin-bottom:26px}.number{display:block;font-size:13px;letter-spacing:.16em;color:var(--muted);margin-bottom:8px}.project h2{font-size:clamp(25px,3vw,42px);margin:0;line-height:1.05}.location{color:var(--muted);margin:10px 0 0}.scope{max-width:600px}.scope span{font-size:11px;text-transform:uppercase;letter-spacing:.16em;color:var(--muted)}.scope p{margin:8px 0 0;line-height:1.65;color:var(--muted);white-space:pre-line}
.slider{position:relative}.slides{position:relative;width:100%;aspect-ratio:16/10;background:#f2f2f0;overflow:hidden}.slides img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:0;transition:opacity .35s ease}.slides img.active{opacity:1}.arrow{position:absolute;top:50%;transform:translateY(-50%);width:48px;height:48px;border:0;background:rgba(255,255,255,.88);font-size:30px;cursor:pointer;z-index:2}.prev{left:16px}.next{right:16px}.slider-tools{display:flex;justify-content:space-between;align-items:center;margin-top:12px}.counter{font-size:13px;color:var(--muted)}.fullscreen{border:0;background:none;text-decoration:underline;cursor:pointer;font:inherit}.thumbs{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:14px;padding:0 4px}.thumbs button{flex:0 0 88px;width:88px;height:66px;padding:0;border:2px solid transparent;background:#eee;overflow:hidden;cursor:pointer}.thumbs button.active{border-color:#111}.thumbs img{width:100%;height:100%;object-fit:cover;display:block}
.cta{margin:0 clamp(18px,4vw,60px) 80px;padding:55px clamp(24px,5vw,70px);background:#171717;color:#fff;display:flex;justify-content:space-between;align-items:center;gap:30px}.cta h2{font-size:clamp(32px,4vw,54px);margin:8px 0}.cta p{color:#d1d1d1;margin:0}.cta .button{display:inline-flex;padding:14px 22px;background:#fff;color:#111;text-decoration:none;white-space:nowrap}.cta .eyebrow{color:#aaa}
@media(max-width:900px){.hero{padding:38px 24px 30px}.hero h1{font-size:clamp(42px,11vw,68px)}.hero p{font-size:16px;margin-top:12px}.project header{grid-template-columns:1fr;gap:18px}.slides{aspect-ratio:4/3}.thumbs{gap:8px}.thumbs button{flex-basis:76px;width:76px;height:57px}.cta{flex-direction:column;align-items:flex-start}}
@media(max-width:600px){.hero{padding:32px 20px 26px}.projects{padding:18px 16px 70px}.project{padding:34px 0 54px}.arrow{width:40px;height:40px}.thumbs{gap:6px}.thumbs button{flex-basis:64px;width:64px;height:48px}}
</style>

<script>
function initSliders(){
 document.querySelectorAll('[data-slider]').forEach(slider=>{
  const slides=Array.from(slider.querySelectorAll('[data-slide]'));const thumbs=Array.from(slider.querySelectorAll('[data-thumb]'));const counter=slider.querySelector('[data-counter]');let current=0;
  function show(index){current=(index+slides.length)%slides.length;slides.forEach((s,i)=>s.classList.toggle('active',i===current));thumbs.forEach((t,i)=>t.classList.toggle('active',i===current));counter.textContent=`${current+1} / ${slides.length}`;}
  slider.querySelector('[data-prev]').addEventListener('click',()=>show(current-1));slider.querySelector('[data-next]').addEventListener('click',()=>show(current+1));thumbs.forEach((t,i)=>t.addEventListener('click',()=>show(i)));
  slider.querySelector('[data-fullscreen]').addEventListener('click',()=>{const img=slides[current];if(img.requestFullscreen)img.requestFullscreen();else if(img.webkitRequestFullscreen)img.webkitRequestFullscreen();});
  slider.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')show(current-1);if(e.key==='ArrowRight')show(current+1);});
  let startX=0;slider.addEventListener('touchstart',e=>startX=e.changedTouches[0].screenX,{passive:true});slider.addEventListener('touchend',e=>{const dx=e.changedTouches[0].screenX-startX;if(Math.abs(dx)>50)show(current+(dx<0?1:-1));},{passive:true});
 });
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initSliders);else initSliders();
</script>
