---

<Layout title="Residential Projects | ATECT Architecture" description="Residential architecture projects by ATECT Architecture in Maryland, Washington DC and Virginia.">
<main>
<section class="hero"><div class="eyebrow">Residential Projects</div><h1>Our Residential Work</h1><p>Explore the residential projects of ATECT Architecture, including renovations, additions and new-home design throughout Maryland and the Washington, DC area.</p></section>
<section class="projects" aria-label="Residential project galleries">
  {projects.map((project, i) => (
    <article class="project-card" id={`project-${i + 1}`}>
      <div class="project-heading">
        <div><div class="eyebrow">{project.name}</div><h2>{project.title}</h2>{project.location && <p class="location">{project.location}</p>}</div>
        <div class="scope">{project.scope}</div>
      </div>
      <div class="gallery" data-gallery>
        <div class="main-image">
          <img src={project.images[0]} alt={`${project.title} project`} loading={i === 0 ? "eager" : "lazy"} />
          <button class="arrow prev" type="button" data-prev aria-label={`Previous image for ${project.title}`}>&#10094;</button>
          <button class="arrow next" type="button" data-next aria-label={`Next image for ${project.title}`}>&#10095;</button>
        </div>
        <div class="thumbs" role="list">
          {project.images.map((image, j) => <button type="button" class={j === 0 ? "active" : ""} aria-label={`View image ${j + 1} of ${project.title}`} data-image={image}><img src={image} alt="" loading="lazy" /></button>)}
        </div>
      </div>
    </article>
  ))}
</section>

<section class="explore-projects"><div class="eyebrow">Explore More Projects</div><h2>See More of Our Work</h2><p>Explore additional ATECT Architecture project categories and visualization services.</p><div class="explore-grid"><a href="/projects/commercial"><span>Commercial Projects</span><strong>View Commercial Work →</strong></a><a href="/projects/custom-homes"><span>Custom Home Plans</span><strong>Explore Custom Homes →</strong></a><a href="/3d-renderings"><span>3-D Renderings</span><strong>View Renderings →</strong></a><a class="explore-all" href="/projects"><span>Portfolio</span><strong>View All Projects →</strong></a></div></section>
<section class="project-cta"><div><div class="eyebrow">Start a Conversation</div><h2>Have a project in mind?</h2><p>Tell us what you're planning and we'll help define the next step.</p><a class="button" href="/contact">Start a Project</a></div></section>
</main>
</Layout>

<style>
.hero{background:var(--paper);border-bottom:1px solid var(--line)}
.projects{max-width:1200px;margin:0 auto;padding:0 24px}
.project-card{padding:70px 0;border-bottom:1px solid var(--line)}
.project-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,520px);gap:50px;align-items:end;margin-bottom:30px}
.project-heading h2{font:600 clamp(32px,4vw,52px)/1 Manrope;letter-spacing:-.04em;margin:0}
.location{margin:8px 0 0;color:var(--muted)}
.scope{font-size:16px;line-height:1.65;color:var(--muted);white-space:pre-line}
.gallery{background:#fff;border:1px solid var(--line);padding:14px}
.main-image{position:relative;aspect-ratio:16/10;display:flex;align-items:center;justify-content:center;background:#fff;overflow:hidden}
.main-image img{width:100%;height:100%;object-fit:contain;display:block}
.arrow{position:absolute;top:50%;transform:translateY(-50%);width:52px;height:52px;border:0;border-radius:50%;background:rgba(17,17,17,.72);color:#fff;font-size:25px;cursor:pointer;z-index:2}
.arrow:hover{background:#fff;color:#111}
.prev{left:22px}.next{right:22px}
.thumbs{display:flex;flex-wrap:nowrap;overflow-x:auto;gap:10px;padding:10px 0 0;scrollbar-width:none}
.thumbs::-webkit-scrollbar{display:none}
.thumbs button{flex:0 0 88px;width:88px;height:66px;border:1px solid #ddd;padding:0;background:#fff;cursor:pointer;overflow:hidden}
.thumbs button.active{border:2px solid #1f2428}
.thumbs img{width:100%;height:100%;object-fit:cover;display:block}
.project-cta{margin-top:0;padding:90px 7vw;background:var(--cta);color:var(--ink)}
.project-cta h2{font:600 clamp(40px,5vw,64px)/.98 Manrope;letter-spacing:-.045em;margin:0 0 16px}
.project-cta p{color:#555b5e;margin:0 0 24px}
.project-cta .button{display:inline-block;background:#1f2428;color:#fff;padding:13px 22px;text-decoration:none}
@media(max-width:900px){.project-heading{grid-template-columns:1fr;gap:18px}.project-card{padding:52px 0}.gallery{padding:10px}.thumbs{gap:8px}.thumbs button{flex-basis:76px;width:76px;height:57px}.arrow{width:48px;height:48px;font-size:23px}.prev{left:16px}.next{right:16px}}
@media(max-width:600px){.projects{padding:0 20px}.project-heading h2{font-size:36px}.scope{font-size:15px}.project-card{padding:42px 0}.gallery{padding:8px}.thumbs{gap:6px}.thumbs button{flex-basis:64px;width:64px;height:48px}.arrow{width:44px;height:44px;font-size:20px}.prev{left:10px}.next{right:10px}.project-cta{padding:70px 24px}}
<style>
.explore-projects{padding:82px clamp(24px,7vw,100px);background:var(--paper);border-top:1px solid var(--line);text-align:center}.explore-projects h2{font:600 clamp(34px,4.5vw,56px)/1.05 Manrope;margin:8px 0 12px;letter-spacing:-.03em}.explore-projects>p{max-width:680px;margin:0 auto 34px;color:#666;line-height:1.7}.explore-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;text-align:left}.explore-grid a{display:flex;flex-direction:column;justify-content:space-between;min-height:125px;padding:22px;border:1px solid var(--line);background:#fff;color:inherit;text-decoration:none;transition:transform .2s ease,border-color .2s ease}.explore-grid a:hover{transform:translateY(-3px);border-color:#111}.explore-grid span{font-size:13px;text-transform:uppercase;letter-spacing:.1em;color:#777}.explore-grid strong{font-size:17px;line-height:1.35}.explore-grid .explore-all{background:#111820;color:#fff;border-color:#111820}.explore-grid .explore-all span{color:#d9dde0}@media(max-width:900px){.explore-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.explore-projects{padding:64px 20px}.explore-grid{grid-template-columns:1fr}.explore-grid a{min-height:105px}}
</style>

</style>

<script>
document.querySelectorAll('[data-gallery]').forEach((gallery) => {
  const main = gallery.querySelector('.main-image img');
  const buttons = Array.from(gallery.querySelectorAll('.thumbs button'));
  const prev = gallery.querySelector('[data-prev]');
  const next = gallery.querySelector('[data-next]');
  let index = 0;

  const show = (nextIndex) => {
    index = (nextIndex + buttons.length) % buttons.length;
    main.src = buttons[index].dataset.image;
    buttons.forEach((item, i) => item.classList.toggle('active', i === index));
  };

  buttons.forEach((button, i) => button.addEventListener('click', () => show(i)));
  prev?.addEventListener('click', () => show(index - 1));
  next?.addEventListener('click', () => show(index + 1));

  gallery.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') show(index - 1);
    if (event.key === 'ArrowRight') show(index + 1);
  });
});
</script>
