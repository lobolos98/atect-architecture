---

<Layout title="Residential Projects | ATECT Architecture" description="Residential architecture projects by ATECT Architecture in Maryland, Washington DC and Virginia.">
  <main>
    <section class="page-hero residential-hero">
      <div class="eyebrow">Residential Projects</div>
      <h1>Our Residential Work</h1>
      <p>Explore the residential projects of ATECT Architecture, including renovations, additions and new-home design throughout Maryland and the Washington, DC area.</p>
    </section>

    <section class="projects-wrap" aria-label="Residential project galleries">
      {projects.map((project, projectIndex) => (
        <article class="project-section">
          <div class="project-heading">
            <div>
              <span class="project-number">{String(projectIndex + 1).padStart(2, "0")}</span>
              <h2>{project.name}</h2>
              {project.location && <p class="location">{project.location}</p>}
            </div>
          </div>

          <div class="gallery">
            {project.images.map((image, imageIndex) => (
              <a class="gallery-item" href={image} target="_blank" rel="noreferrer" aria-label={`View ${project.title} image ${imageIndex + 1}`}>
                <img src={image} alt={`${project.title} — project image ${imageIndex + 1}`} loading={projectIndex === 0 && imageIndex < 3 ? "eager" : "lazy"} />
              </a>
            ))}
          </div>

          <div class="scope">
            <div class="eyebrow">Scope of Work:</div>
            <p>{project.scope}</p>
          </div>
        </article>
      ))}
    </section>

    <section class="cta-section">
      <div class="eyebrow">Start a Conversation</div>
      <h2>Love what you see?</h2>
      <p>Get in touch today and let’s see what we can build together.</p>
      <a class="button" href="/contact">Contact Us Today</a>
    </section>
  </main>
</Layout>

<style>
  .residential-hero { max-width: 980px; }
  .residential-hero p { max-width: 760px; margin-inline: auto; }
  .projects-wrap { width: min(1400px, calc(100% - 40px)); margin: 0 auto; }
  .project-section { padding: 80px 0 92px; border-top: 1px solid #e5e7eb; }
  .project-section:first-child { border-top: 0; padding-top: 30px; }
  .project-heading { display: flex; justify-content: center; text-align: center; margin-bottom: 34px; }
  .project-number { display: block; font-size: 12px; letter-spacing: .2em; color: #777; margin-bottom: 10px; }
  .project-heading h2 { margin: 0; font-size: clamp(28px, 4vw, 46px); line-height: 1.08; letter-spacing: -.02em; }
  .location { margin: 10px 0 0; color: #666; font-size: 15px; }
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .gallery-item { display: block; overflow: hidden; background: #f2f2f2; aspect-ratio: 4 / 3; }
  .gallery-item:nth-child(3n + 1) { aspect-ratio: 4 / 3; }
  .gallery-item img { width: 100%; height: 100%; display: block; object-fit: cover; transition: transform .45s ease; }
  .gallery-item:hover img, .gallery-item:focus-visible img { transform: scale(1.035); }
  .scope { max-width: 860px; margin: 38px auto 0; text-align: center; padding: 30px 34px; background: #f7f7f5; }
  .scope .eyebrow { font-size: 12px; letter-spacing: .15em; margin-bottom: 10px; }
  .scope p { margin: 0; color: #4b4b4b; font-size: 17px; line-height: 1.75; }
  .cta-section { text-align: center; padding: 110px 24px; background: #f4f4f2; }
  .cta-section h2 { margin: 8px 0 14px; font-size: clamp(34px, 5vw, 58px); }
  .cta-section p { max-width: 650px; margin: 0 auto 28px; color: #555; font-size: 18px; line-height: 1.7; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 24px; text-decoration: none; border: 1px solid currentColor; }
  @media (max-width: 900px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .projects-wrap { width: min(100% - 24px, 1400px); }
    .project-section { padding: 58px 0 68px; }
    .gallery { grid-template-columns: 1fr; gap: 10px; }
    .gallery-item { aspect-ratio: 4 / 3; }
    .scope { padding: 24px 18px; margin-top: 26px; }
    .scope p { font-size: 16px; }
    .cta-section { padding: 78px 18px; }
  }
</style>
