---
import Layout from "../../layouts/Layout.astro";
const projects=[
 {name:"The Lis–Perlis Residence",location:"Chevy Chase",image:"https://atectarchitecture.com/assets/images/image05.jpg?v=5bc6d0ed",text:"A two-phase project: a redesigned front entry followed by a second-story sunroom positioned to capture southern rear views."},
 {name:"The McNeill Residence",location:"White Plains",image:"https://static.wixstatic.com/media/fb4db5_f3b2ed31ce824ac2be3520f031e3eef4~mv2_d_5312_2988_s_4_2.jpeg/v1/fill/w_1400,h_900,al_c,q_90,enc_auto/fb4db5_f3b2ed31ce824ac2be3520f031e3eef4~mv2_d_5312_2988_s_4_2.jpeg",text:"An extensive kitchen extension and redesign with contemporary cabinetry, generous counters, natural light and a formal dining area."},
 {name:"The Mowhawk Drive Residence",location:"Swan Point",image:"https://static.wixstatic.com/media/fb4db5_fc8cf9a2735a487aa19915078017e397~mv2_d_5312_2988_s_4_2.jpeg/v1/fill/w_1400,h_900,al_c,q_90,enc_auto/fb4db5_fc8cf9a2735a487aa19915078017e397~mv2_d_5312_2988_s_4_2.jpeg",text:"A new two-story home with a front porch, spacious screen porch, rear deck and an open floor plan connecting the great room, eating nook and kitchen."},
 {name:"The Anderson Residence",location:"Annapolis",image:"https://static.wixstatic.com/media/fb4db5_fe9b40835e04481ba3d1ab7fbf6d94a9~mv2_d_2979_3929_s_4_2.jpg/v1/fill/w_1400,h_900,al_c,q_90,enc_auto/fb4db5_fe9b40835e04481ba3d1ab7fbf6d94a9~mv2_d_2979_3929_s_4_2.jpg",text:"A new two-story home featuring a prominent two-level entry porch."},
 {name:"The Turner Residence",location:"Upper Marlboro",image:"https://static.wixstatic.com/media/fb4db5_91524b19d9b147ad8499291e67e7d1bf~mv2.jpg/v1/fill/w_1400,h_900,al_c,q_90,enc_auto/fb4db5_91524b19d9b147ad8499291e67e7d1bf~mv2.jpg",text:"A residential project featured in ATECT's construction-photo portfolio."}
];
---
<Layout title="Residential Projects | ATECT Architecture" description="Selected residential architecture projects by ATECT Architecture in Maryland and the DC area.">
<section class="page-hero"><div class="eyebrow">Residential Projects</div><h1>Homes designed around the way people live.</h1><p>Selected ATECT residential projects, including additions, renovations and new-home design.</p></section>
<section class="section"><div class="res-grid">{projects.map(project=><article><div class="image" style={`background-image:url('${project.image}')`} role="img" aria-label={`${project.name} project image`}></div><div class="copy"><div class="eyebrow">{project.location}</div><h2>{project.name}</h2><p>{project.text}</p></div></article>)}</div></section>
<section class="section alt"><a class="button dark" href="/contact">Start a Residential Project</a></section>
</Layout>
<style is:global>.res-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.res-grid article{border:1px solid #ddd;background:#fff}.res-grid article:first-child{grid-column:1/-1;display:grid;grid-template-columns:1.35fr .65fr}.image{aspect-ratio:4/3;background-size:cover;background-position:center}.res-grid article:first-child .image{aspect-ratio:auto;min-height:420px}.copy{padding:28px}.copy h2{font:600 clamp(26px,3vw,40px)/1.08 Manrope;margin:0 0 12px}.copy p{color:#555;line-height:1.7}@media(max-width:800px){.res-grid{grid-template-columns:1fr}.res-grid article:first-child{grid-column:auto;display:block}.res-grid article:first-child .image{min-height:0;aspect-ratio:4/3}}</style>
