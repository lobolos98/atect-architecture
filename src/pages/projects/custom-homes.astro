---
import Layout from "../../layouts/Layout.astro";

const plans = [
  {
    name: "Prairie View",
    image: "https://static.wixstatic.com/media/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png/v1/fill/w_1400,h_900,al_c,q_95,enc_auto/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png",
    size: "Approximately 2,500 heated sq. ft.",
    bedrooms: "3",
    bathrooms: "3.5",
    features: [
      "One-level living at its finest",
      "Owner’s suite with dual bathrooms and walk-in closets",
      "Oversized front porch"
    ],
    description: "Whether you’re looking to build your dream home or seeking a practical yet elegant design, the Prairie View Home Plan delivers on both fronts."
  },
  {
    name: "NVA Home Plan",
    image: "https://static.wixstatic.com/media/fb4db5_6aa1b4210c184d92b564dca830787c38~mv2.png/v1/fill/w_1400,h_900,al_c,q_95,enc_auto/fb4db5_6aa1b4210c184d92b564dca830787c38~mv2.png",
    size: "Approximately 4,000 sq. ft.",
    bedrooms: "3",
    bathrooms: "3.5",
    features: [
      "Grand two-story covered entry",
      "Generous screen porch and rear deck with pergola",
      "Open floor plan connecting great room, eating nook and kitchen"
    ],
    description: "Whether you’re envisioning a cozy family home or a stylish retreat, the NVA Home Plan offers a blend of elegance and functionality."
  }
];

const visualizations = [
  {
    name: "Prairie View",
    image: "https://static.wixstatic.com/media/fb4db5_ed2537c226ff4d75b78df1bf5d755c78f002.jpg",
    alt: "Prairie View home visualization"
  },
  {
    name: "NVA",
    image: "https://static.wixstatic.com/media/fb4db5_cb46365c9fef425aa743dc104c93473a~mv2.png",
    alt: "NVA home visualization"
  }
];
---

<Layout title="Custom Home Plans | ATECT Architecture" description="Custom home plans from ATECT Architecture, including Prairie View and NVA concepts tailored to individual needs and lifestyles.">
  <section class="page-hero">
    <div class="eyebrow">Custom Home Plans</div>
    <h1>Plans tailored to your needs and lifestyle.</h1>
    <p>Choose from our meticulously crafted designs or collaborate with us to create something truly one-of-a-kind.</p>
  </section>

  <section class="section intro-section">
    <div class="intro-copy">
      <div class="eyebrow">Custom Home Design</div>
      <h2>Designed around the way you want to live.</h2>
      <p>Custom Home Plans are tailored to your unique needs and lifestyle. Explore the plans below for inspiration, or work with ATECT Architecture to develop a home that responds to your property, priorities and vision.</p>
    </div>
    <div class="consultation-card">
      <div class="eyebrow">Architectural Consultations</div>
      <h3>Have questions?</h3>
      <p>Need guidance? We’re here to listen and provide expert advice.</p>
      <a class="button dark" href="/contact">Contact Us Today</a>
    </div>
  </section>

  <section class="section plans-section">
    <div class="section-heading">
      <div class="eyebrow">Featured Plans</div>
      <h2>Explore our custom home concepts.</h2>
    </div>

    <div class="plans">
      {plans.map((plan, index) => (
        <article class="plan-card">
          <div class="plan-image">
            <img src={plan.image} alt={`${plan.name} exterior rendering`} loading={index === 0 ? "eager" : "lazy"} />
          </div>
          <div class="plan-copy">
            <div class="eyebrow">Home Plan</div>
            <h3>{plan.name}</h3>
            <div class="plan-stats">
              <div><span>Size</span><strong>{plan.size}</strong></div>
              <div><span>Bedrooms</span><strong>{plan.bedrooms}</strong></div>
              <div><span>Bathrooms</span><strong>{plan.bathrooms}</strong></div>
            </div>
            <h4>Features</h4>
            <ul>
              {plan.features.map(feature => <li>{feature}</li>)}
            </ul>
            <p class="plan-description">{plan.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section visualization-section">
    <div class="section-heading">
      <div class="eyebrow">Visualize the Design</div>
      <h2>See your home before it is built.</h2>
      <p>Architectural visualizations help communicate the character, proportions and exterior design of a proposed home.</p>
    </div>

    <div class="visualization-grid">
      {visualizations.map((item) => (
        <article class="visual-card">
          <div class="visual-image"><img src={item.image} alt={item.alt} loading="lazy" /></div>
          <div class="visual-copy">
            <div class="eyebrow">Home Visualization</div>
            <h3>{item.name}</h3>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section alt project-cta">
    <div>
      <div class="eyebrow">Start Your Custom Home</div>
      <h2>Love what you see?</h2>
      <p>Get in touch today and let’s see what we can build together.</p>
    </div>
    <a class="button dark" href="/contact">Contact Us Today</a>
  </section>
</Layout>

<style is:global>
  .intro-section{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.75fr);gap:clamp(40px,7vw,100px);align-items:start}
  .intro-copy h2,.section-heading h2,.project-cta h2{font:600 clamp(34px,4.5vw,58px)/1.05 Manrope;margin:0 0 22px;letter-spacing:-.03em}
  .intro-copy p,.section-heading p{color:#555;line-height:1.8;font-size:18px;max-width:760px}
  .consultation-card{background:#f3f1ec;padding:34px;border-top:4px solid #111}
  .consultation-card h3{font:600 30px/1.1 Manrope;margin:8px 0 12px}
  .consultation-card p{color:#555;line-height:1.7;margin:0 0 24px}
  .plans-section{padding-top:20px}
  .section-heading{max-width:780px;margin-bottom:42px}
  .plans{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}
  .plan-card{border:1px solid #ddd;background:#fff}
  .plan-image{background:#111;aspect-ratio:16/10;overflow:hidden}
  .plan-image img{width:100%;height:100%;object-fit:cover;display:block}
  .plan-copy{padding:32px}
  .plan-copy h3,.visual-copy h3{font:600 clamp(30px,3.5vw,46px)/1.05 Manrope;margin:0 0 20px;letter-spacing:-.025em}
  .plan-stats{display:grid;grid-template-columns:1.5fr .7fr .7fr;gap:12px;padding:18px 0;border-top:1px solid #ddd;border-bottom:1px solid #ddd;margin-bottom:22px}
  .plan-stats div{display:flex;flex-direction:column;gap:5px}
  .plan-stats span{font-size:11px;text-transform:uppercase;letter-spacing:.12em;color:#777}
  .plan-stats strong{font-size:15px;line-height:1.35;font-weight:600;color:#222}
  .plan-copy h4{font:600 16px/1.2 Manrope;text-transform:uppercase;letter-spacing:.08em;margin:0 0 10px}
  .plan-copy ul{margin:0 0 18px;padding-left:20px}
  .plan-copy li,.plan-description{color:#555;line-height:1.7}
  .plan-description{margin:18px 0 0}
  .visualization-section{padding-top:20px}
  .visualization-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}
  .visual-card{background:#f3f1ec}
  .visual-image{aspect-ratio:16/10;background:#111;overflow:hidden}
  .visual-image img{width:100%;height:100%;object-fit:cover;display:block}
  .visual-copy{padding:22px 26px 28px}
  .visual-copy h3{font-size:32px;margin-bottom:0}
  .project-cta{display:flex;justify-content:space-between;align-items:center;gap:40px}
  .project-cta h2{margin-bottom:12px}
  .project-cta p{color:#555;line-height:1.7;margin:0}
  @media(max-width:900px){
    .intro-section{grid-template-columns:1fr}
    .plans,.visualization-grid{grid-template-columns:1fr}
  }
  @media(max-width:600px){
    .plan-copy{padding:26px}
    .plan-stats{grid-template-columns:1fr 1fr}
    .plan-stats div:first-child{grid-column:1/-1}
    .project-cta{flex-direction:column;align-items:flex-start}
  }
</style>
