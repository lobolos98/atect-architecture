---
import Layout from "../../layouts/Layout.astro";
const plans=[
 {name:"Prairie View",image:"https://static.wixstatic.com/media/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png/v1/fill/w_1400,h_900,al_c,q_95,enc_auto/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png",size:"Approximately 2,500 heated sq. ft.",features:["3 bedrooms","3.5 bathrooms","One-level living","Owner's suite with dual bathrooms and walk-in closets","Oversized front porch"]},
 {name:"NVA Home Plan",image:"https://static.wixstatic.com/media/fb4db5_e1f3205c361a4a32b52b836295beab11~mv2.png/v1/fill/w_680,h_382,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/NVA%20Home%20exterior%20rendering.png",size:"Approximately 4,000 sq. ft.",features:["3 bedrooms","3.5 bathrooms","Grand two-story covered entry","Generous screen porch and rear deck with pergola","Open floor plan connecting great room, eating nook and kitchen"]}
];
---
<Layout title="Custom Home Plans | ATECT Architecture" description="Custom home plans from ATECT Architecture, including Prairie View and NVA concepts tailored to individual needs and lifestyles.">
<section class="page-hero"><div class="eyebrow">Custom Home Plans</div><h1>Plans tailored to your needs and lifestyle.</h1><p>ATECT's custom home planning work can start from a developed concept or collaborate with you to create something one-of-a-kind.</p></section>
<section class="section"><div class="plans">{plans.map(plan=><article><div class="plan-image" style={`background-image:url('${plan.image}')`} role="img" aria-label={`${plan.name} home plan image`}></div><div class="plan-copy"><div class="eyebrow">Custom Home Plan</div><h2>{plan.name}</h2><p><strong>Size:</strong> {plan.size}</p><ul>{plan.features.map(feature=><li>{feature}</li>)}</ul></div></article>)}</div></section>

<section class="explore-projects"><div class="eyebrow">Explore More Projects</div><h2>See More of Our Work</h2><p>Explore residential and commercial projects, plus the visualization work that brings architectural ideas to life.</p><div class="explore-grid"><a href="/projects/residential"><span>Residential Projects</span><strong>View Residential Work →</strong></a><a href="/projects/commercial"><span>Commercial Projects</span><strong>View Commercial Work →</strong></a><a href="/3d-renderings"><span>3-D Renderings</span><strong>View Renderings →</strong></a><a class="explore-all" href="/projects"><span>Portfolio</span><strong>View All Projects →</strong></a></div></section>
<section class="section alt"><div class="section-head"><div><div class="eyebrow">Architectural Consultation</div><h2>Have questions about a home plan?</h2></div><p class="section-intro">Start with a conversation about your property, needs and the type of home you want to create.</p></div><a class="button dark" href="/contact">Contact ATECT</a></section>
</Layout>
<style is:global>.plans{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.plans article{border:1px solid #ddd;background:#fff}.plan-image{aspect-ratio:16/10;background-size:cover;background-position:center}.plan-copy{padding:30px}.plan-copy h2{font:600 clamp(30px,4vw,48px)/1.05 Manrope;margin:0 0 16px}.plan-copy p,.plan-copy li{color:#555;line-height:1.7}.plan-copy ul{padding-left:20px}@media(max-width:800px){.plans{grid-template-columns:1fr}}.explore-projects{padding:82px clamp(24px,7vw,100px);background:var(--paper);border-top:1px solid var(--line);text-align:center}.explore-projects h2{font:600 clamp(34px,4.5vw,56px)/1.05 Manrope;margin:8px 0 12px;letter-spacing:-.03em}.explore-projects>p{max-width:680px;margin:0 auto 34px;color:#666;line-height:1.7}.explore-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;text-align:left}.explore-grid a{display:flex;flex-direction:column;justify-content:space-between;min-height:125px;padding:22px;border:1px solid var(--line);background:#fff;color:inherit;text-decoration:none;transition:transform .2s ease,border-color .2s ease}.explore-grid a:hover{transform:translateY(-3px);border-color:#111}.explore-grid span{font-size:13px;text-transform:uppercase;letter-spacing:.1em;color:#777}.explore-grid strong{font-size:17px;line-height:1.35}.explore-grid .explore-all{background:#111820;color:#fff;border-color:#111820}.explore-grid .explore-all span{color:#d9dde0}@media(max-width:900px){.explore-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.explore-projects{padding:64px 20px}.explore-grid{grid-template-columns:1fr}.explore-grid a{min-height:105px}}</style>
