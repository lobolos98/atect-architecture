---
import Layout from "../layouts/Layout.astro";

const resources = [
  {
    number: "01",
    category: "Design & Documentation",
    title: "Architectural Design Tools",
    href: "/resources/design-tools",
    text: "Tools and resources that support planning, visualization, drawing, specification, and documentation for residential and commercial projects.",
  },
  {
    number: "02",
    category: "Construction",
    title: "Builder & Contractor Resources",
    href: "/resources/construction",
    text: "Practical jobsite products, equipment, references, and resources selected with construction coordination and project delivery in mind.",
  },
  {
    number: "03",
    category: "Home & Interiors",
    title: "Fixtures, Finishes & Hardware",
    href: "/resources/home-interiors",
    text: "A focused starting point for exploring lighting, hardware, plumbing fixtures, finishes, and architectural details.",
  },
  {
    number: "04",
    category: "Technology",
    title: "Technology for the Built Environment",
    href: "/resources/technology",
    text: "Technology and equipment that can support design workflows, project organization, visualization, field documentation, and productivity.",
  },
];

const selectionPrinciples = [
  "Relevant to real design and construction workflows",
  "Useful for homeowners, builders, contractors, or design professionals",
  "Products and services that can complement a well-planned project",
  "Information presented clearly so you can evaluate options for yourself",
];

const affiliateLinks = [
  // Impact partner links will be added here after brand approvals.
  // Example:
  // {
  //   title: "Product or Partner",
  //   category: "Technology",
  //   description: "Short editorial description.",
  //   url: "YOUR_IMPACT_TRACKING_URL",
  // },
];
---

<Layout
  title="ATECT Architecture Picks | ATECT Architecture"
  description="ATECT Architecture Picks: products, tools, materials, and resources selected for better residential and commercial design and construction projects."
>
  <section class="page-hero">
    <p class="eyebrow">ATECT Architecture Resources</p>
    <h1>Products, tools & resources for better projects.</h1>
    <p>
      A curated resource library from ATECT Architecture for homeowners, builders,
      contractors, and design professionals looking for useful products and services
      related to the built environment.
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Curated by ATECT Architecture</p>
        <h2>ATECT Architecture Picks</h2>
      </div>
      <p class="section-intro">
        Products, tools & resources selected for better projects. We are building
        this collection around the products, tools, and resources that can support
        better decisions before and during a project.
      </p>
    </div>

    <div class="resource-grid">
      {resources.map((resource) => (
        <article class="resource-card">
          <div class="resource-top">
            <span class="resource-number">{resource.number}</span>
            <span class="resource-category">{resource.category}</span>
          </div>
          <h3>{resource.title}</h3>
          <p>{resource.text}</p>
          <a class="resource-link" href={resource.href}>Explore this resource area →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section alt">
    <div class="section-head">
      <div>
        <p class="eyebrow">How We Select</p>
        <h2>Useful first. Promotional second.</h2>
      </div>
      <p class="section-intro">
        The goal of this library is to provide practical information—not turn the
        ATECT website into a shopping catalog.
      </p>
    </div>

    <div class="principles">
      {selectionPrinciples.map((principle, index) => (
        <div class="principle">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <p>{principle}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Recommended Products</p>
        <h2>Selected resources</h2>
      </div>
      <p class="section-intro">
        Specific partner recommendations will appear here as ATECT Architecture
        builds relationships with relevant brands and suppliers.
      </p>
    </div>

    {affiliateLinks.length > 0 ? (
      <div class="product-grid">
        {affiliateLinks.map((item) => (
          <article class="product-card">
            <p class="eyebrow">{item.category}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <a
              class="button dark"
              href={item.url}
              target="_blank"
              rel="sponsored noopener noreferrer"
            >
              View Product
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <div class="status-mark">IN DEVELOPMENT</div>
        <p class="eyebrow">Impact Partner Network</p>
        <h3>A focused collection is on the way.</h3>
        <p>
          ATECT Architecture is preparing a selection of products and services
          relevant to design, construction, interiors, and professional workflows.
          Partner recommendations will be added as the resource library develops.
        </p>
      </div>
    )}
  </section>

  <section class="section disclosure">
    <div class="disclosure-inner">
      <p class="eyebrow">Affiliate Disclosure</p>
      <h2>Transparent recommendations.</h2>
      <p>
        Some links on this page may be affiliate links. If you purchase through an
        affiliate link, ATECT Architecture may receive a commission at no additional
        cost to you. Affiliate relationships do not change the price you pay.
      </p>
      <p>
        Product availability, pricing, specifications, warranties, and other terms
        are determined by the individual retailer or partner. Please review the
        partner's current information before making a purchase.
      </p>
    </div>
  </section>

  <section class="section cta-section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Planning a Project?</p>
        <h2>Let's design the project first.</h2>
      </div>
      <p class="section-intro">
        The right products work best when they are part of a well-planned design.
        ATECT Architecture provides residential and commercial design services,
        construction-ready documentation, and project coordination.
      </p>
    </div>
    <a class="button dark" href="/contact">Start a Project</a>
  </section>
</Layout>

<style>
.resource-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}.resource-card{padding:38px;background:#fff;border:1px solid var(--line);min-height:270px;display:flex;flex-direction:column}.resource-top{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:32px}.resource-number{font:600 12px/1 Manrope;letter-spacing:.08em}.resource-category{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#777;text-align:right}.resource-card h3,.product-card h3,.empty-state h3{font:600 28px/1.15 Manrope;margin:0 0 12px}.resource-card p,.product-card p,.empty-state p{color:var(--muted);max-width:650px}.resource-link{display:inline-block;margin-top:auto;padding-top:18px;font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#111;border-top:1px solid var(--line);font-weight:700}.principles{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line)}.principle{display:grid;grid-template-columns:52px 1fr;gap:20px;padding:25px 20px 25px 0;border-bottom:1px solid var(--line)}.principle:nth-child(even){padding-left:30px;border-left:1px solid var(--line)}.principle span{font:600 11px/1 Manrope;color:#777;padding-top:5px}.principle p{margin:0;color:var(--text)}.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.product-card{background:#fff;border:1px solid var(--line);padding:32px;min-height:270px}.product-card .button{margin-top:18px}.empty-state{background:#fff;border:1px solid var(--line);padding:clamp(35px,6vw,70px);max-width:950px}.status-mark{display:inline-block;margin-bottom:35px;padding:8px 12px;border:1px solid var(--line);font-size:9px;letter-spacing:.14em;font-weight:600}.disclosure{background:#fff}.disclosure-inner{max-width:850px;border-top:1px solid var(--line);padding-top:45px}.disclosure h2{font:600 clamp(32px,5vw,52px) Manrope;margin:0 0 18px;letter-spacing:-.035em}.disclosure p{color:var(--muted);max-width:760px}.cta-section .button{margin-top:10px}@media(max-width:800px){.resource-grid,.product-grid,.principles{grid-template-columns:1fr}.resource-card,.product-card{min-height:0}.principle,.principle:nth-child(even){padding:22px 0;border-left:0}.empty-state{padding:35px 24px}}
</style>
