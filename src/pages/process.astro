---
import Layout from "../layouts/Layout.astro";

const steps = [
  { number: "01", title: "Discover", text: "We start by understanding your property, goals, priorities, budget considerations and the scope you are considering.", items: ["Initial consultation", "Project goals and priorities", "Property and existing-condition review", "Project scope and next steps"] },
  { number: "02", title: "Design", text: "We translate the project needs into a design direction, developing the layout, form and details around how the project needs to work.", items: ["Concept development", "Floor-plan planning", "Exterior design direction", "Options, revisions and design decisions"] },
  { number: "03", title: "Document", text: "The selected design is developed into coordinated architectural drawings that can support pricing, permitting and construction.", items: ["Plans and elevations", "Architectural details", "Construction-document sets", "Code and ADA coordination as applicable"] },
  { number: "04", title: "Approve", text: "When permitting is part of the scope, we help move the documentation through the approval process and respond to required revisions.", items: ["Permit documentation", "Agency coordination", "Plan-review responses", "Required revisions"] },
  { number: "05", title: "Build", text: "Once the project moves toward construction, ATECT can provide design and documentation support as needed and contracted.", items: ["Builder and contractor coordination", "Design clarification", "Documentation support", "Construction-phase design assistance"] }
];

---

<Layout title="Architecture Design Process | ATECT Architecture" description="Explore the ATECT Architecture process from discovery and design through construction documents, permitting and construction support.">
  <section class="page-hero">
    <div class="eyebrow">Process</div>
    <h1>A clear path from concept to construction.</h1>
    <p>ATECT guides projects through discovery, design, documentation and the next phase—while adapting the process to the needs of each project.</p>
  </section>

  <section class="section process-visual" aria-label="From architectural blueprint to completed design">
    <div class="visual-frame blueprint-transition">
      <div class="visual-half blueprint-half">
        <img src="https://static.wixstatic.com/media/9aae58f8cb39c0432380467cfa4e74eb.jpg/v1/fill/w_1600,h_1000,al_c,q_90,enc_auto/9aae58f8cb39c0432380467cfa4e74eb.jpg" alt="Architectural blueprint design" loading="eager" />
        <div class="visual-label">BLUEPRINT · DESIGN INTENT</div>
      </div>
      <div class="visual-half completed-half">
        <img src="https://static.wixstatic.com/media/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png/v1/fill/w_1600,h_1000,al_c,q_95,enc_auto/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png" alt="Completed architectural design" loading="eager" />
        <div class="visual-label">COMPLETED DESIGN</div>
      </div>
      <div class="transition-arrow" aria-hidden="true"><span>FROM</span><strong>→</strong><span>TO</span></div>
    </div>
    <div class="visual-caption"><span>From design intent</span><strong>to a coordinated, build-ready design</strong></div>
  </section>
  <section class="section process-section">
    <div class="section-intro">
      <div class="eyebrow">The ATECT Process</div>
      <h2>Five stages. One coordinated path.</h2>
      <p>The exact scope changes with the project. The process below shows the common path from the first conversation through construction support.</p>
    </div>

    <div class="process-flow" aria-label="Project process">
      {steps.map((step, index) => (
        <div class="flow-item">
          <span class="flow-number">{step.number}</span>
          <span class="flow-title">{step.title}</span>
          {index < steps.length - 1 && <span class="flow-arrow" aria-hidden="true">→</span>}
        </div>
      ))}
    </div>

    <div class="process-list">
      {steps.map((step) => (
        <article class="process-step">
          <div class="number">{step.number}</div>
          <div class="step-content">
            <div class="step-heading">
              <span class="step-label">Stage {step.number}</span>
              <h2>{step.title}</h2>
            </div>
            <p class="step-intro">{step.text}</p>
            <ul>
              {step.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section fit-section">
    <div class="fit-copy">
      <div class="eyebrow">Flexible by Design</div>
      <h2>Start where your project needs us.</h2>
      <p>Not every project requires every stage. ATECT can join a project during early planning, design development, construction documentation, permitting, or when additional design and drafting support is needed.</p>
    </div>
    <div class="fit-card">
      <span>Project stages can include</span>
      <strong>Planning · Design · Documentation · Permitting · Construction Support</strong>
      <div class="fit-note">Scope is tailored to the services your project actually requires.</div>
    </div>
  </section>

  <section class="section builder-section">
    <div>
      <div class="eyebrow">For Builders &amp; Contractors</div>
      <h2>Documentation that helps move projects forward.</h2>
    </div>
    <p>ATECT provides construction-ready documentation and coordination for builders and contractors, including drawing clarification, revisions and project-specific design support as contracted.</p>
  </section>

  <section class="section process-cta">
    <div>
      <div class="eyebrow">Start a Conversation</div>
      <h2>Have a project in mind?</h2>
      <p>Let's discuss where you are in the process and what kind of design support you need.</p>
    </div>
    <a class="button dark" href="/contact">Start a Conversation</a>
  </section>
</Layout>

<style is="global">
  .process-visual{padding-top:26px;padding-bottom:18px}
  .visual-frame{position:relative;max-width:1240px;margin:0 auto;overflow:hidden;display:grid;grid-template-columns:1fr 1fr;min-height:390px;background:#111}
  .visual-half{position:relative;min-width:0;overflow:hidden}
  .visual-half img{display:block;width:100%;height:100%;min-height:390px;object-fit:cover}
  .blueprint-half img{filter:saturate(.82)}
  .visual-half::after{content:"";position:absolute;inset:0;pointer-events:none}
  .blueprint-half::after{background:linear-gradient(90deg,rgba(8,42,76,.08),rgba(8,42,76,.16))}
  .completed-half::after{background:linear-gradient(90deg,rgba(255,255,255,.14),rgba(255,255,255,0))}
  .visual-label{position:absolute;left:24px;bottom:22px;z-index:1;padding:9px 13px;background:rgba(0,0,0,.68);color:#fff;font:600 10px Manrope;letter-spacing:.14em}
  .transition-arrow{position:absolute;z-index:3;left:50%;top:50%;transform:translate(-50%,-50%);width:78px;height:78px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#fff;box-shadow:0 10px 35px rgba(0,0,0,.22);color:#111}
  .transition-arrow span{font:600 7px Manrope;letter-spacing:.14em;color:#777}
  .transition-arrow strong{font:400 27px/1 Manrope}
  .visual-frame::after{content:"";position:absolute;z-index:2;left:50%;top:0;bottom:0;width:170px;transform:translateX(-50%);background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.28),rgba(255,255,255,0));pointer-events:none}
  .visual-caption{max-width:1240px;margin:0 auto;padding:18px 0 0;display:flex;flex-direction:column;gap:4px}
  .visual-caption span{font:600 11px Manrope;text-transform:uppercase;letter-spacing:.12em;color:#888}
  .visual-caption strong{font:600 22px/1.3 Manrope;color:#111}
  .process-section{padding-top:68px}
  .section-intro{max-width:800px;margin-bottom:42px}
  .section-intro h2{font:600 clamp(34px,4.5vw,58px)/1.05 Manrope;margin:8px 0 16px;letter-spacing:-.03em}
  .section-intro p{max-width:720px;color:#555;font-size:17px;line-height:1.75;margin:0}
  .process-flow{display:flex;align-items:center;border-top:1px solid #d8d5cf;border-bottom:1px solid #d8d5cf;margin-bottom:70px}
  .flow-item{position:relative;display:flex;align-items:center;gap:12px;flex:1;padding:20px 24px 20px 0;min-width:0}
  .flow-item:not(:first-child){padding-left:24px}
  .flow-number{font:600 12px Manrope;color:#888;letter-spacing:.08em}
  .flow-title{font:600 16px Manrope;white-space:nowrap}
  .flow-arrow{margin-left:auto;color:#aaa;font-size:22px}
  .process-list{border-top:1px solid #d8d5cf}
  .process-step{display:grid;grid-template-columns:80px minmax(0,900px);gap:clamp(24px,5vw,70px);padding:58px 0;border-bottom:1px solid #d8d5cf}
  .number{font:600 15px Manrope;color:#888;padding-top:8px}
  .step-label{display:block;font:600 11px Manrope;color:#999;text-transform:uppercase;letter-spacing:.12em;margin-bottom:8px}
  .step-content h2{font:600 clamp(34px,4.5vw,58px)/1.05 Manrope;margin:0 0 16px;letter-spacing:-.03em}
  .step-intro{max-width:780px;color:#555;font-size:18px;line-height:1.75;margin:0 0 26px}
  .step-content ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 36px;max-width:820px;margin:0;padding:0;list-style:none}
  .step-content li{border-top:1px solid #e4e1dc;padding:11px 0;color:#333;font-size:15px;line-height:1.5}
  .step-content li::before{content:"— ";color:#999}
  .fit-section{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.75fr);gap:clamp(40px,7vw,100px);align-items:center;background:#f3f1ec}
  .fit-copy h2,.builder-section h2,.process-cta h2{font:600 clamp(34px,4.5vw,58px)/1.05 Manrope;margin:0 0 18px;letter-spacing:-.03em}
  .fit-copy p{max-width:760px;color:#555;font-size:18px;line-height:1.75;margin:0}
  .fit-card{background:#fff;padding:32px;border-top:3px solid #111}
  .fit-card span{display:block;font:600 12px Manrope;color:#888;letter-spacing:.08em;text-transform:uppercase;margin-bottom:18px}
  .fit-card strong{font:600 21px/1.45 Manrope;color:#111}
  .fit-note{margin-top:18px;padding-top:16px;border-top:1px solid #e4e1dc;color:#666;font-size:14px;line-height:1.6}
  .builder-section{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.9fr);gap:clamp(40px,8vw,110px);align-items:start}
  .builder-section h2{max-width:700px}
  .builder-section>p{margin:4px 0 0;color:#555;font-size:18px;line-height:1.8}
  .process-cta{display:flex;justify-content:space-between;align-items:center;gap:40px;background:#111;color:#fff}
  .process-cta .eyebrow{color:#aaa}
  .process-cta h2{margin-bottom:12px}
  .process-cta p{color:#ccc;font-size:17px;line-height:1.7;margin:0;max-width:650px}
  .process-cta .button{flex:0 0 auto;background:#fff;color:#111;border-color:#fff}
  .process-cta .button:hover{background:transparent;color:#fff}
  @media(max-width:900px){
    .process-flow{overflow-x:auto}
    .flow-item{flex:0 0 auto;min-width:145px}
    .flow-arrow{margin-left:8px}
    .fit-section,.builder-section{grid-template-columns:1fr}
    .visual-frame{min-height:340px}
    .blueprint-side,.finished-side{padding:24px 22px}
  }
  @media(max-width:700px){
    .process-visual{padding:20px 20px 0}
    .visual-frame{grid-template-columns:1fr;min-height:0}
    .blueprint-side,.finished-side{min-height:255px}
    .transition-arrow{top:50%;left:50%;width:62px;height:62px}
    .transition-arrow strong{font-size:23px}
    .visual-frame::after{left:0;top:50%;right:0;bottom:auto;width:auto;height:120px;transform:translateY(-50%);background:linear-gradient(180deg,rgba(13,49,87,.15),rgba(255,255,255,.65),rgba(255,255,255,0))}
    .finished-caption{position:static;max-width:none;margin-top:-12px}
    .visual-caption{padding:20px}
    .visual-caption strong{font-size:18px}
    .process-section{padding-top:50px}
    .process-flow{margin-bottom:50px}
    .flow-item{min-width:135px;padding-right:18px}
    .flow-item:not(:first-child){padding-left:18px}
    .flow-title{font-size:14px}
    .process-step{grid-template-columns:42px minmax(0,1fr);gap:12px;padding:42px 0}
    .step-content h2{font-size:34px}
    .step-intro{font-size:16px}
    .step-content ul{grid-template-columns:1fr}
  }
  @media(max-width:600px){
    .fit-card{padding:26px}
    .process-cta{align-items:flex-start;flex-direction:column}
    .builder-section>p{font-size:16px}
  }
</style>
