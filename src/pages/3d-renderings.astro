nd:#fff;border:1px solid #ddd}.animation-image{position:relative;aspect-ratio:16/9;overflow:hidden}.animation-image img,.animation-image video{width:100%;height:100%;object-fit:cover;display:block;background:#111}.animation-image video{object-fit:contain}.play-badge{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:54px;height:54px;border-radius:50%;background:#000b;color:#fff;display:grid;place-items:center}.duration{position:absolute;right:10px;bottom:10px;background:#000c;color:#fff;padding:5px 8px;font-size:12px}.animation-copy{padding:15px 16px 18px}.animation-copy h3{margin:0 0 5px;font-size:18px}.animation-copy p{margin:0;color:#777;font-size:14px}.cta-section{text-align:center;padding:92px 24px;background:#111820;color:#fff}.cta-section .eyebrow{color:#d7c8a2}.cta-section h2{margin:10px 0 12px}.cta-section p{max-width:650px;margin:0 auto 28px;line-height:1.8;color:#d9dde0}.button{display:inline-block;padding:14px 22px;text-decoration:none;font-weight:700;border:1px solid currentColor}.button.dark{background:#111820;color:#fff;border-color:#111820}@media(max-width:900px){.animation-grid{grid-template-columns:repeat(2,1fr)}.panorama-embed iframe{height:520px}}@media(max-width:640px){.page-hero{padding:40px 20px 36px;scroll-margin-top:72px}.page-hero p{font-size:16px}.section{padding:58px 20px}.render-slider{aspect-ratio:4/3}.animation-grid{grid-template-columns:1fr}.panorama-embed iframe{height:420px}.thumbs button{flex-basis:72px;height:50px}}
.explore-projects{padding:82px clamp(24px,7vw,100px);background:var(--paper);border-top:1px solid var(--line);text-align:center}.explore-projects h2{font:600 clamp(34px,4.5vw,56px)/1.05 Manrope;margin:8px 0 12px;letter-spacing:-.03em}.explore-projects>p{max-width:680px;margin:0 auto 34px;color:#666;line-height:1.7}.explore-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;text-align:left}.explore-grid a{display:flex;flex-direction:column;justify-content:space-between;min-height:125px;padding:22px;border:1px solid var(--line);background:#fff;color:inherit;text-decoration:none;transition:transform .2s ease,border-color .2s ease}.explore-grid a:hover{transform:translateY(-3px);border-color:#111}.explore-grid span{font-size:13px;text-transform:uppercase;letter-spacing:.1em;color:#777}.explore-grid strong{font-size:17px;line-height:1.35}.explore-grid .explore-all{background:#111820;color:#fff;border-color:#111820}.explore-grid .explore-all span{color:#d9dde0}@media(max-width:900px){.explore-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.explore-projects{padding:64px 20px}.explore-grid{grid-template-columns:1fr}.explore-grid a{min-height:105px}}</style>
