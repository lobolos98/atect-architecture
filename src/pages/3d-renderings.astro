---
import Layout from "../layouts/Layout.astro";
const views=[
 {title:"Interior Kitchen Design",image:"https://static.wixstatic.com/media/fb4db5_5dc3a057ee8c45c497ab0239f3dad090~mv2_d_3840_2160_s_2.jpeg/v1/fill/w_1400,h_900,al_c,q_90,enc_auto/fb4db5_5dc3a057ee8c45c497ab0239f3dad090~mv2_d_3840_2160_s_2.jpeg"},
 {title:"Prairie View Residence",image:"https://static.wixstatic.com/media/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png/v1/fill/w_1400,h_900,al_c,q_95,enc_auto/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png"},
 {title:"Blueprint Design",image:"https://static.wixstatic.com/media/9aae58f8cb39c0432380467cfa4e74eb.jpg/v1/fill/w_1400,h_900,al_c,q_90,enc_auto/9aae58f8cb39c0432380467cfa4e74eb.jpg"}
];
---
<Layout title="3D Renderings & Visualization | ATECT Architecture" description="Explore ATECT Architecture's 3D rendering and visualization services, including exterior renderings, interior renderings, 360 panoramas and architectural animations.">
<section class="page-hero"><div class="eyebrow">3D Renderings</div><h1>See the design before it is built.</h1><p>ATECT's original site describes 3D renderings as a way to visualize residential and commercial projects and bring design ideas to life.</p></section>
<section class="section"><div class="render-grid">{views.map(view=><figure><div class="render-image" style={`background-image:url('${view.image}')`} role="img" aria-label={view.title}></div><figcaption>{view.title}</figcaption></figure>)}</div></section>
<section class="section alt"><div class="section-head"><div><div class="eyebrow">Visualization services</div><h2>Exterior. Interior. Immersive.</h2></div><p class="section-intro">ATECT identifies exterior renderings, interior renderings, 360 panoramas and architectural animations as visualization options.</p></div><a class="button dark" href="/contact">Discuss Visualization</a></section>
</Layout>
<style is:global>.render-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.render-grid figure{margin:0;border:1px solid #ddd;background:#fff}.render-grid figure:first-child{grid-column:1/-1}.render-image{aspect-ratio:16/10;background-size:cover;background-position:center}.render-grid figure:not(:first-child) .render-image{aspect-ratio:4/3}.render-grid figcaption{padding:16px 20px;font:600 14px Manrope;letter-spacing:.04em}@media(max-width:800px){.render-grid{grid-template-columns:1fr}.render-grid figure:first-child{grid-column:auto}}</style>
