---
const { title = "ATECT Architecture | Residential & Commercial Design", description = "Architectural design services for residential and commercial projects throughout Maryland, Washington, DC, and Virginia." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <link rel="canonical" href={Astro.url} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ATECT Architecture home">
        <span class="brand-mark">A</span>
        <span><strong>ATECT</strong><small>ARCHITECTURE</small></span>
      </a>
      <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">MENU</button>
      <nav class="nav" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/projects">Projects</a>
        <a href="/process">Process</a>
        <a href="/reviews">Reviews</a>
        <a class="nav-cta" href="/contact">Start a Project</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div>
        <div class="footer-brand">ATECT ARCHITECTURE</div>
        <p>Residential & commercial architectural design.</p>
      </div>
      <div>
        <p><strong>Service Area</strong><br />Maryland • Washington, DC • Virginia</p>
      </div>
      <div>
        <p><strong>Contact</strong><br /><a href="/contact">Start a Project</a></p>
      </div>
      <div class="footer-bottom">© {new Date().getFullYear()} ATECT Architecture. All rights reserved. <a href="/privacy">Privacy</a></div>
    </footer>
    <script>
      const button = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.nav');
      button?.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        button.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700&display=swap');
:root{--ink:#111;--muted:#666;--paper:#f7f7f5;--line:#ddd;--accent:#9b1c1c}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:#fff;font-family:'DM Sans',Arial,sans-serif;line-height:1.6}a{color:inherit;text-decoration:none}.site-header{height:88px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(24px,5vw,72px);border-bottom:1px solid #eee;background:#fff;position:sticky;top:0;z-index:20}.brand{display:flex;align-items:center;gap:12px}.brand-mark{display:grid;place-items:center;width:42px;height:42px;background:#111;color:#fff;font-family:Manrope;font-weight:700;font-size:23px}.brand strong{display:block;font:700 21px/1 Manrope;letter-spacing:.08em}.brand small{display:block;font-size:9px;letter-spacing:.27em;margin-top:5px;color:#777}.nav{display:flex;align-items:center;gap:27px;text-transform:uppercase;font-size:11px;letter-spacing:.11em}.nav a:hover{opacity:.55}.nav-cta{background:#111;color:#fff!important;padding:13px 18px}.menu-toggle{display:none;background:none;border:0;font:600 11px Manrope;letter-spacing:.1em}.site-footer{background:#111;color:#fff;padding:58px clamp(24px,7vw,100px) 24px;display:grid;grid-template-columns:2fr 1fr 1fr;gap:35px}.footer-brand{font:700 22px Manrope;letter-spacing:.1em}.site-footer p{color:#bbb}.site-footer a{color:#fff}.footer-bottom{grid-column:1/-1;border-top:1px solid #333;padding-top:20px;color:#888;font-size:12px}.footer-bottom a{margin-left:15px;color:#aaa}
.hero{min-height:calc(100vh - 88px);display:grid;align-items:end;padding:clamp(40px,8vw,100px);position:relative;overflow:hidden;background:linear-gradient(120deg,rgba(0,0,0,.74),rgba(0,0,0,.18)),url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2200&q=85') center/cover}.hero-content{max-width:850px;color:#fff}.eyebrow{text-transform:uppercase;letter-spacing:.25em;font-size:11px;margin-bottom:18px}.hero h1{font:600 clamp(48px,8vw,105px)/.96 Manrope;margin:0 0 24px;letter-spacing:-.045em}.hero p{font-size:clamp(17px,2vw,22px);max-width:670px;color:#eee}.button{display:inline-block;margin-top:18px;background:#fff;color:#111;padding:15px 22px;font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.button.dark{background:#111;color:#fff}.section{padding:100px clamp(24px,7vw,100px)}.section.alt{background:var(--paper)}.section-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:45px}.section h2{font:600 clamp(32px,5vw,62px)/1 Manrope;letter-spacing:-.035em;margin:0}.section-intro{max-width:500px;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:#fff;border:1px solid var(--line)}.project-image{aspect-ratio:4/3;background-size:cover;background-position:center}.project-copy{padding:22px}.project-copy h3{font:600 23px Manrope;margin:0 0 5px}.project-copy p{margin:0;color:var(--muted);font-size:14px}.feature{display:grid;grid-template-columns:1.1fr .9fr;min-height:560px}.feature-image{background:url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1500&q=85') center/cover}.feature-copy{padding:clamp(35px,6vw,85px);display:flex;flex-direction:column;justify-content:center;background:#111;color:#fff}.feature-copy p{color:#bbb;max-width:540px}.service-grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line)}.service{padding:35px 20px 35px 0;border-bottom:1px solid var(--line)}.service h3{font:600 25px Manrope;margin:0 0 8px}.service p{color:var(--muted);max-width:520px}.page-hero{padding:100px clamp(24px,7vw,100px);background:var(--paper)}.page-hero h1{font:600 clamp(50px,8vw,100px)/.95 Manrope;letter-spacing:-.05em;max-width:1000px;margin:0}.page-hero p{max-width:650px;font-size:19px;color:var(--muted);margin-top:25px}.prose{max-width:850px;padding:80px clamp(24px,7vw,100px)}.prose h2{font:600 38px Manrope}.prose p,.prose li{font-size:17px;color:#444}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px}.contact-form{display:grid;gap:18px}.contact-form label{font-size:12px;text-transform:uppercase;letter-spacing:.1em;font-weight:700}.contact-form input,.contact-form textarea,.contact-form select{width:100%;padding:14px;border:1px solid #bbb;font:inherit;background:#fff}.contact-form textarea{min-height:150px}.contact-form button{border:0;background:#111;color:#fff;padding:16px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.project-large{grid-column:span 2}.project-large .project-image{aspect-ratio:16/8}
@media(max-width:800px){.site-header{height:72px}.menu-toggle{display:block}.nav{display:none;position:absolute;top:72px;left:0;right:0;background:#fff;border-bottom:1px solid #ddd;padding:18px 24px;flex-direction:column;align-items:stretch;gap:0}.nav.open{display:flex}.nav a{padding:14px 0}.nav-cta{padding:14px!important;text-align:center}.grid,.contact-grid,.feature,.service-grid{grid-template-columns:1fr}.project-large{grid-column:auto}.site-footer{grid-template-columns:1fr}.footer-bottom{grid-column:auto}.hero{min-height:78vh}.section{padding:70px 24px}.page-hero{padding:70px 24px}.prose{padding:60px 24px}}
</style>