---
const {
  title = "ATECT Architecture | Residential & Commercial Design Firm",
  description = "ATECT Architecture provides residential and commercial architectural design services throughout Maryland, Washington, DC, and Virginia.",
  image = "/og-image.svg",
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://atectarchitecture.com").toString();
const absoluteImage = new URL(image, "https://atectarchitecture.com").toString();
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const sectionMap = { "/about": "About", "/services": "Services", "/projects": "Projects", "/process": "Process", "/reviews": "Reviews", "/resources": "Resources", "/contact": "Contact", "/residential-architecture": "Services", "/custom-home-design": "Services", "/home-addition-design": "Services", "/architectural-construction-documents": "Services", "/permit-drawing-services": "Services", "/3d-renderings": "3D Renderings", "/3d-architectural-renderings": "3D Renderings", "/architectural-design-firm-cost": "Resources", "/architectural-design-firm-vs-drafting": "Resources", "/maryland-architect": "Service Areas", "/washington-dc-architect": "Service Areas", "/northern-virginia-architect": "Service Areas", "/privacy": "Privacy" };
const segmentLabel = (segment) => segment.split("-").map((word) => word ? word[0].toUpperCase() + word.slice(1) : "").join(" ");
const segments = path === "/" ? [] : path.split("/").filter(Boolean);
const parentPath = segments.length > 1 ? "/" + segments[0] : null;
const parentName = parentPath === "/resources" ? "Resources" : parentPath === "/projects" ? "Projects" : parentPath ? sectionMap[parentPath] : null;
const breadcrumbs = path === "/" ? [] : [
  { "@type": "ListItem", position: 1, name: "Home", item: "https://atectarchitecture.com/" },
  ...(parentName && parentPath ? [{ "@type": "ListItem", position: 2, name: parentName, item: "https://atectarchitecture.com" + parentPath }] : []),
  ...((parentName && parentPath) ? [{ "@type": "ListItem", position: 3, name: title.replace(/\s*\|\s*ATECT Architecture.*$/i, "") }] : [{ "@type": "ListItem", position: 2, name: sectionMap[path] || segmentLabel(segments.at(-1) || "") }])
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d5d7d5" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ATECT Architecture" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      name: "ATECT Architecture",
      url: "https://atectarchitecture.com",
      description,
      areaServed: ["Maryland", "Washington, DC", "Virginia"],
      serviceType: ["Residential Architecture", "Commercial Architecture", "Construction Documents", "3D Visualization"],
      mainEntityOfPage: canonical
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "ATECT Architecture",
      url: "https://atectarchitecture.com/"
    })} />
    {breadcrumbs.length >= 2 && <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs
    })} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ATECT Architecture home">
        <img class="brand-logo" src="https://static.wixstatic.com/media/c990e5_61068258b54b474b8405550262740d11~mv2_d_4800_2568_s_4_2.jpg/v1/fill/w_149,h_80,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/c990e5_61068258b54b474b8405550262740d11~mv2_d_4800_2568_s_4_2.jpg" alt="ATECT Architecture" />
      </a>
      <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="site-nav">MENU</button>
      <nav class="nav" id="site-nav" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/projects">Projects</a>
        <a href="/3d-renderings">3D Renderings</a>
        <a href="/process">Process</a>
        <a href="/reviews">Reviews</a>
        <a href="/resources">Resources</a>
        <a class="nav-cta" href="/contact">Start a Project</a>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div><div class="footer-brand">ATECT ARCHITECTURE</div><p>Residential & commercial architectural design.</p></div>
      <div><p><strong>Service Area</strong><br /><a href="/maryland-architect">Maryland</a> • <a href="/washington-dc-architect">Washington, DC</a> • <a href="/northern-virginia-architect">Northern Virginia</a></p></div>
      <div><p><strong>Explore</strong><br /><a href="/projects">Projects</a> · <a href="/services">Services</a> · <a href="/residential-architecture">Residential Architecture</a> · <a href="/architectural-construction-documents">Construction Documents</a> · <a href="/contact">Start a Project</a><br /><a href="/architectural-design-firm-cost">Architectural Design Firm Costs</a> · <a href="/architectural-design-firm-vs-drafting">Design Firm vs. Drafting</a> · <a href="/resources">ATECT Architecture Resources</a></p></div>
      <div class="footer-bottom">© {new Date().getFullYear()} ATECT Architecture. All rights reserved. <a href="/privacy">Privacy</a></div>
    </footer>
    <script>
      const button = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.nav');
      button?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open') ?? false;
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        nav.classList.remove('open');
        button?.setAttribute('aria-expanded', 'false');
        button?.setAttribute('aria-label', 'Open navigation');
      }));
    </script>
  </body>
</html>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700&display=swap');
:root{--ink:#111;--muted:#666;--paper:#f5f5f2;--line:#ddd;--accent:#9b1c1c;--cta:#e7e8e6;--footer:#d5d7d5}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:#fff;font-family:'DM Sans',Arial,sans-serif;line-height:1.6}a{color:inherit;text-decoration:none}.skip-link{position:absolute;left:-9999px;top:auto}.skip-link:focus{left:15px;top:15px;background:#fff;padding:10px 14px;z-index:100}
.site-header{min-height:88px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(20px,5vw,72px);border-bottom:1px solid #eee;background:#fff;position:sticky;top:0;z-index:20}.brand{display:flex;align-items:center;gap:12px}.brand-logo{display:block;width:126px;height:auto;max-height:62px;object-fit:contain}.nav{display:flex;align-items:center;gap:22px;text-transform:uppercase;font-size:10px;letter-spacing:.1em}.nav a:hover{opacity:.55}.nav-cta{background:#111;color:#fff!important;padding:13px 17px}.menu-toggle{display:none;background:none;border:0;font:600 11px Manrope;letter-spacing:.1em}
.site-footer{background:var(--footer);color:var(--ink);padding:58px clamp(24px,7vw,100px) 24px;display:grid;grid-template-columns:2fr 1fr 1fr;gap:35px}.footer-brand{font:700 22px Manrope;letter-spacing:.1em}.site-footer p{color:#4f5558}.site-footer a{color:var(--ink)}.footer-bottom{grid-column:1/-1;border-top:1px solid #b9bdbb;padding-top:20px;color:#666c70;font-size:12px}.footer-bottom a{margin-left:15px;color:#4f5558}
.hero{min-height:calc(100vh - 88px);display:grid;align-items:end;padding:clamp(40px,8vw,100px);position:relative;overflow:hidden;background:linear-gradient(120deg,rgba(0,0,0,.78),rgba(0,0,0,.16)),url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2200&q=85') center/cover}.hero-content{max-width:900px;color:#fff}.eyebrow{text-transform:uppercase;letter-spacing:.25em;font-size:11px;margin-bottom:18px}.hero h1{font:600 clamp(48px,8vw,105px)/.96 Manrope;margin:0 0 24px;letter-spacing:-.045em}.hero p{font-size:clamp(17px,2vw,22px);max-width:690px;color:#eee}.button{display:inline-block;margin-top:18px;background:#fff;color:#111;padding:15px 22px;font-size:11px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.button.dark{background:#111;color:#fff}.button.outline{background:transparent;color:#111;border:1px solid #111}
.section{padding:100px clamp(24px,7vw,100px)}.section.alt{background:var(--paper)}.section-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:45px}.section h2{font:600 clamp(32px,5vw,62px)/1 Manrope;letter-spacing:-.035em;margin:0}.section-intro{max-width:500px;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:#fff;border:1px solid var(--line);transition:transform .25s ease,box-shadow .25s ease}.card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,.08)}.project-image{aspect-ratio:4/3;background-size:cover;background-position:center}.project-copy{padding:22px}.project-copy h3{font:600 23px Manrope;margin:0 0 5px}.project-copy p{margin:0;color:var(--muted);font-size:14px}
.feature{display:grid;grid-template-columns:1.1fr .9fr;min-height:560px}.feature-image{background:url('https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1500&q=85') center/cover}.feature-copy{padding:clamp(35px,6vw,85px);display:flex;flex-direction:column;justify-content:center;background:var(--cta);color:var(--ink)}.feature-copy p{color:#555b5e;max-width:540px}.feature-copy .eyebrow{color:#666d70}.feature-copy .button{background:#1f2428;color:#fff}.service-grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--line)}.service{padding:35px 20px 35px 0;border-bottom:1px solid var(--line)}.service h3{font:600 25px Manrope;margin:0 0 8px}.service p{color:var(--muted);max-width:520px}
.page-hero{text-align:left;padding:58px clamp(24px,7vw,100px) 46px;background:var(--paper)}.page-hero h1{font:600 clamp(46px,7vw,82px)/.95 Manrope;letter-spacing:-.05em;max-width:1000px;margin:0}.page-hero p{max-width:700px;font-size:18px;line-height:1.65;color:var(--muted);margin:18px 0 0}.prose{max-width:900px;padding:80px clamp(24px,7vw,100px)}.prose h2{font:600 38px Manrope}.prose p,.prose li{font-size:17px;color:#444}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px}.contact-form{display:grid;gap:18px}.contact-form label{font-size:12px;text-transform:uppercase;letter-spacing:.1em;font-weight:700}.contact-form input,.contact-form textarea,.contact-form select{width:100%;padding:14px;border:1px solid #bbb;font:inherit;background:#fff}.contact-form textarea{min-height:150px}.contact-form button{border:0;background:#111;color:#fff;padding:16px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;cursor:pointer}.project-large{grid-column:span 2}.project-large .project-image{aspect-ratio:16/8}.stat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);margin-top:55px}.stat{background:#fff;padding:35px}.stat strong{display:block;font:600 38px Manrope}.stat span{color:var(--muted);font-size:13px}
body:has(.projects) .hero{min-height:0;display:block;padding:46px clamp(24px,7vw,100px) 36px;background:var(--paper);border-bottom:1px solid var(--line);position:relative;overflow:visible}
body:has(.projects) .hero .eyebrow{margin-bottom:10px;color:var(--ink)}
body:has(.projects) .hero h1{font:600 clamp(46px,7vw,78px)/.95 Manrope;letter-spacing:-.05em;max-width:900px;margin:0;color:var(--ink)}
body:has(.projects) .hero p{max-width:760px;margin:14px 0 0;font-size:17px;line-height:1.55;color:var(--muted)}
.contact-cta,.process-cta,.project-cta,.cta-section{background:var(--cta)!important;color:var(--ink)!important}.contact-cta h2,.process-cta h2,.project-cta h2,.cta-section h2{color:var(--ink)}.contact-cta p,.process-cta p,.project-cta p,.cta-section p{color:#555b5e}.contact-cta .eyebrow,.process-cta .eyebrow,.project-cta .eyebrow,.cta-section .eyebrow{color:#666d70}.contact-cta .button,.process-cta .button,.project-cta .button,.cta-section .button{background:#1f2428;color:#fff}
.thumbs{display:flex!important;flex-wrap:nowrap!important;justify-content:flex-start!important;overflow-x:auto!important;overflow-y:hidden!important;gap:10px!important;padding:0 4px 6px!important;scrollbar-width:none;-webkit-overflow-scrolling:touch}.thumbs::-webkit-scrollbar{display:none}.thumbs button{flex:0 0 88px!important;width:88px!important}.thumbs button.active{border-color:#111}
@media(max-width:1000px){.nav{gap:14px}.nav a:nth-child(5){display:none}}@media(max-width:800px){.site-header{min-height:72px}.brand-logo{width:108px;max-height:54px}.menu-toggle{display:block}.nav{display:none;position:absolute;top:72px;left:0;right:0;background:#fff;border-bottom:1px solid #ddd;padding:18px 24px;flex-direction:column;align-items:stretch;gap:0}.nav.open{display:flex}.nav a{padding:14px 0}.nav a:nth-child(5){display:block}.nav-cta{padding:14px!important;text-align:center}.grid,.contact-grid,.feature,.service-grid,.stat-grid{grid-template-columns:1fr}.project-large{grid-column:auto}.site-footer{grid-template-columns:1fr}.footer-bottom{grid-column:auto}.hero{min-height:78vh;padding:32px 24px 60px}.section{padding:70px 24px}.section-head{display:block}.section-intro{margin-top:20px}.page-hero{padding:48px 24px 40px}.page-hero h1{font-size:clamp(42px,11vw,68px)}.page-hero p{font-size:16px;margin-top:14px}.prose{padding:60px 24px}}
@media(max-width:900px){.thumbs{gap:8px!important}.thumbs button{flex-basis:76px!important;width:76px!important;height:57px!important}body:has(.projects) .hero{padding:38px 24px 30px}body:has(.projects) .hero h1{font-size:clamp(42px,11vw,68px)}body:has(.projects) .hero p{font-size:16px;margin-top:12px}}
@media(max-width:600px){.thumbs{gap:6px!important}.thumbs button{flex-basis:64px!important;width:64px!important;height:48px!important}body:has(.projects) .hero{padding:32px 20px 26px}}
@media(max-width:800px){
  .feature{display:flex!important;flex-direction:column!important;min-height:0!important}
  .feature-image{width:100%!important;height:auto!important;min-height:0!important;aspect-ratio:4/3!important;background-image:none!important;background-color:#f5f5f2!important;display:block!important;position:relative!important}
  .feature-image::before{content:"";position:absolute;inset:0;background-image:url('https://static.wixstatic.com/media/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png/v1/fill/w_1600,h_1000,al_c,q_95,enc_auto/fb4db5_b380ee2f335e48bfa5a7079e9098ce54~mv2.png');background-repeat:no-repeat;background-position:center;background-size:contain}
  .feature-copy{padding:40px 24px!important}
}

</style>

